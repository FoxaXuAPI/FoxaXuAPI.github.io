_sipcfg.open "{SYS_NROOT}/SystemUpdate/Downloading/catalog.cfg"

_var {LatestVersion} = _sipcfg LatestVersion;

_file_write "[%time%][CSU] Reported Kernel:  {CSU_Update_Edition} Latest version :  {LatestVersion}";

_if(_<("{CSU_System_version}","{LatestVersion}"))|_return "NeedUpdate";
_if(!_<("{CSU_System_version}","{LatestVersion}"))|_return "Latest";
_return "MissingMatchIF";


:installupdate;

_if(_file_exist "{SetupVolume}/Coral/SystemUser/TaskUserExecute/task.ca")|_return "ExistingUpdateNeedInstall"; 
