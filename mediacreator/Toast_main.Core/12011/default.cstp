_cover <"{SYS_NROOT}/CoSxS/CoralFDL.SystemUpdateServices.Core/csuerror.ca"> "COUSOWORK_ERROR_START";
_return "false";


:CancelUpdate;
_file_del "{SetupVolume}/Coral/SystemUser/TaskUserExecute/task.ca";
