_$directmode;

_if(!_cp("{NATVC_isAdmin}","1"))|_goto :FAIL_DISALLOW;

_cout "Type your New user name";
_cout "This name code is use for login"
_var {tempargs} = _getline;

_if(_cp("{tempargs}","SYSTEM"))|_goto :USERFAIL_ACCESSDENIND;
_if(_cp("{tempargs}","Local_Driver_Security_User"))|_goto :USERFAIL_ACCESSDENIND;
_if(_cp("{tempargs}","admin"))|_goto :USERFAIL_ACCESSDENIND;
_if(_cp("{tempargs}","default"))|_goto :USERFAIL_ACCESSDENIND;
_if(_cp("{tempargs}","defaultPassword"))|_goto :USERFAIL_ACCESSDENIND;

_sipcfg.open "{NATVC_CONFIG_USERS}"

_var {NATVC_USERPROFILE} = _sipcfg {tempargs};

_if(!_cp("{NATVC_USERPROFILE}",'{varspace.null}')) | _goto :USERFAIL_EXISTUSER;
_free {NATVC_USERPROFILE};

_var _ARGS_NU_ID = "{tempargs}";

_cout "Type your full name";
_cout "This name is use for display"
_var _ARGS_NU_FULLNAME = _getline;

_cout "Type your password ";
_cout "login reqired. if not need. Press Enter";
_var _ARGS_NU_PSWD = _getline;
_if(_cp("_ARGS_NU_PSWD",'{varspace.null}')) | _var _ARGS_NU_PSWD = "@nopswd";

_cout "Is this user is admin? ";
_cout "Yes type 1. No type 0";
_var _ARGS_NU_ADMIN = _getline;
_if(_cp("_ARGS_NU_ADMIN","1"))|_goto :PASSTYPE;
_if(_cp("_ARGS_NU_ADMIN","0"))|_goto :PASSTYPE;
_goto :BadUserStatus;

:PASSTYPE;
_var {umback} = _script<"{SYS_ROOT}/usermgr.ca"> "newuser";
