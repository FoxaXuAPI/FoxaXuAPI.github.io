_var {tempargs} = _getline;

_if(_cp("{tempargs}","SYSTEM"))|_goto :USERFAIL_ACCESSDENIND;
_if(_cp("{tempargs}","Local_Driver_Security_User"))|_goto :USERFAIL_ACCESSDENIND;
_if(_cp("{tempargs}","admin"))|_goto :USERFAIL_ACCESSDENIND;
_if(_cp("{tempargs}","default"))|_goto :USERFAIL_ACCESSDENIND;
