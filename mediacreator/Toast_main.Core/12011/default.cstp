$CSTP_FILE_RECORD_MARK_ID_START(/User-Reset-Password.ca);
_$directmode;

_cout "Select User to Reset Password";
_cout "Type your userid"
_var {tempargs} = _getline;

_if(_cp("{tempargs}","{NATVC_WHOIS}"))|_goto :SkipAuthCheck;
_if(!_cp("{NATVC_isAdmin}","1"))|_goto :FAIL_DISALLOW;

:SkipAuthCheck;
_if(_cp("{tempargs}","SYSTEM"))|_goto :USERFAIL_ACCESSDENIND;
_if(_cp("{tempargs}","Local_Driver_Security_User"))|_goto :USERFAIL_ACCESSDENIND;
_if(_cp("{tempargs}","default"))|_goto :USERFAIL_ACCESSDENIND;
_if(_cp("{tempargs}","defaultPassword"))|_goto :USERFAIL_ACCESSDENIND;

_sipcfg.open "{NATVC_CONFIG_USERS}"

_var {NATVC_USERPROFILE} = _sipcfg {tempargs};

_if(_cp("{NATVC_USERPROFILE}",'{varspace.null}')) | _goto :USERFAIL_NOUSER;

_sipcfg.open "{NATVC_DISK}/{NATVC_USERPROFILE}/userconfig";
_if(_cp(_sipcfg DisableUser,"1"))|_goto :BadUserStatus;
_var {OldRealPSWD} = _sipcfg UserPassword;

_cout "Type your old password to confirm";
_var {UserType} = _getline;
_if(_cp("{UserType}",'{varspace.null}')) | _var {UserType} = "@nopswd";

_if(!_cp("{UserType}","{OldRealPSWD}"))|_goto :VerifyFailed;

:ReConfirmNewPSWD;
_cout "Type your new password";
_var {UserType_A} = _getline;
_if(_cp("{UserType_A}",'{varspace.null}')) | _var {UserType_A} = "@nopswd";

_cout "Confirm your new password";
_var {UserType_B} = _getline;
_if(_cp("{UserType_B}",'{varspace.null}')) | _var {UserType_B} = "@nopswd";

_if(!_cp("{UserType_A}","{UserType_B}"))|_cout "Password set failed. Confirm failed!";
_if(!_cp("{UserType_A}","{UserType_B}"))|_pause;
_if(!_cp("{UserType_A}","{UserType_B}"))|_goto :ReConfirmNewPSWD;
_sipcfg.open "{NATVC_DISK}/{NATVC_USERPROFILE}/userconfig";
_sipcfg UserPassword = "{UserType_A}";
_cout "Set New password succeed!";
_cout "{NATVC_DISK}/{NATVC_USERPROFILE}/userconfig ";
_return "true";

:FAIL_DISALLOW;
_cout "Admin Required!";
_return "false";

:USERFAIL_NOUSER;
_cout "Cannot Found this user. ";
_return "false";

:USERFAIL_ACCESSDENIND;
_cout "This users cannot managed. Because System Security has not allowed! ";
_return "false";

:BadUserStatus;
_cout "This users cannot managed. Because Admin Disabled this user!. Enable this user first!";
_return "false";

:VerifyFailed;
_cout "Credential verification failed! Password wrong";
_return "false";
$CSTP_FILE_RECORD_MARK_ID_END(/User-Reset-Password.ca);
