$CSTP_FILE_RECORD_MARK_ID_START(/Source/CSU_SERVICE.CSTP);
Calcium_Text_Pack_File  New Format
//START EXTRACT
$CSTP_FILE_RECORD_MARK_ID_START(/CoralFDL.SystemUpdateServices.Core/CodeIndex.txt);
Developer helps

csucore.ca 
    Argument
        cleanup   -return ok
        checkupdate  -return  Latest / NeedUpdate / false
        installupdate  -return  NotNeedUpdate / ExistingUpdateNeedInstall / NeedRestart /false
$CSTP_FILE_RECORD_MARK_ID_END(/CoralFDL.SystemUpdateServices.Core/CodeIndex.txt);
$CSTP_FILE_RECORD_MARK_ID_START(/CoralFDL.SystemUpdateServices.Core/cousowork.ca);
_$directmode;

//Coral Update Service Orchestrator
//System Update Workers

//Deployment and setup


//Check File
_if(!_file_exist "{SYS_NROOT}/SystemUpdate/Downloading/boot.cstp")|_goto :BadFileInfo;
_if(!_file_exist "{SYS_NROOT}/SystemUpdate/Downloading/default.cstp")|_goto :BadFileInfo;
_if(!_file_exist "{SYS_NROOT}/SystemUpdate/Downloading/install.cstp")|_goto :BadFileInfo;


//Checking Recovery Status
_sipcfg.open "{NATVC_CONFIG_SETUP}"
_if(!_cp(_sipcfg SystemRE_Status,"true"))|_goto :SkipUpdateRE;
_file_del "{SystemRE_Dir}/Recovery/colre.cstp";
_file_copy ("{SYS_NROOT}/SystemUpdate/Downloading/boot.cstp","{SystemRE_Dir}/Recovery/colre.cstp");

//Succeed

:SkipUpdateRE;
//Expand default installer
_file_uncstp ("{SYS_NROOT}/SystemUpdate/Downloading/default.cstp","{SYS_NROOT}/SystemUpdate/DeployStore");

//Expand Origin OS
_file_uncstp ("{SYS_NROOT}/SystemUpdate/Downloading/install.cstp","{SYS_NROOT}/SystemUpdate/NewOS");

//DELETE SOURCE FILES
_dir_remove "{SYS_NROOT}/SystemUpdate/NewOS/Users/admin";
_file_del "{SYS_NROOT}/SystemUpdate/NewOS/Coral/config/SETUP";
_file_del "{SYS_NROOT}/SystemUpdate/NewOS/Coral/config/USERS";
_file_del "{SYS_NROOT}/SystemUpdate/NewOS/Coral/config/SOFTWARE";
_file_del "{SYS_NROOT}/SystemUpdate/NewOS/Coral/config/PRODUCT";
//DEPLOYMENT COMPLETE


//Deploy Delay Update Service
_file_open "{SetupVolume}/Coral/SystemUser/TaskUserExecute/task.ca";
_file_write ' _clear; ';
_file_write ' _typefile "{SYS_NROOT}/CoSxS/CoralFDL.SystemUpdateServices.Core/text/coral-updater.txt"; ';
_file_write ' _script <"{SYS_NROOT}/CoSxS/CoralFDL.SystemUpdateServices.Core/filecomponent.ca">';
_file_open "{SYS_LOG}";


//EndTask
_file_open "{SetupVolume}/Coral/SystemUser/TaskUserExecute/startupTask.ca";
_file_write ' _clear; ';
_file_write ' _typefile "{SYS_NROOT}/CoSxS/CoralFDL.SystemUpdateServices.Core/text/coral-modeploy.txt"; ';
_file_write ' _script <"{SYS_NROOT}/CoSxS/CoralFDL.SystemUpdateServices.Core/modeploy.ca">';
_file_open "{SYS_LOG}";

_return "NeedRestart";

:BadFileInfo;
_cout "Update Service Orchestrator Error!";
_cout "File missing. run diskclean to clean all caches";
_cout "or contact foxaxu dev lab to resolve this problem";
_pause;
_return "false";
$CSTP_FILE_RECORD_MARK_ID_END(/CoralFDL.SystemUpdateServices.Core/cousowork.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/CoralFDL.SystemUpdateServices.Core/csucore.ca);
_$directmode;

//Coral System Update Services :   CSU
//CSU Core

//System Update Works

_file_write "[%time%][CSU] Coral System Update Service is starting";

//Check Is System Supported CSU?
_sipcfg.open "{NATVC_CONFIG_SYSTEM}";
_if(!_cp(_sipcfg CSU_Core_Status,"true"))|_cover <"{SYS_NROOT}/CoSxS/CoralFDL.SystemUpdateServices.Core/csuerror.ca"> "CSU_ERR_NOTSUPPORTED";

_file_write "[%time%][CSU] CSU is supported";




//Get Agent
_var {tempargs} = _getargs;
_file_write "[%time%][CSU] Argument with code :  {tempargs}";

_dir_make "{SYS_NROOT}/SystemUpdate";
_dir_make "{SYS_NROOT}/SystemUpdate/Downloading";
_dir_make "{SYS_NROOT}/SystemUpdate/DeployStore";

_if(_cp("{tempargs}","cleanup"))|_goto :CleanUpdateCache;
_if(_cp("{tempargs}","checkupdate"))|_goto :CheckUpdate;
_if(_cp("{tempargs}","installupdate"))|_goto :installupdate;
_if(_cp("{tempargs}","cancelupdate"))|_goto :CancelUpdate;

_cover <"{SYS_NROOT}/CoSxS/CoralFDL.SystemUpdateServices.Core/csuerror.ca"> "CSU_ERR_INVAILD_ARGUMENT::{tempargs}";
_return "nullcover";


:CleanUpdateCache;
_dir_remove "{SYS_NROOT}/SystemUpdate";
_dir_make "{SYS_NROOT}/SystemUpdate";
_dir_make "{SYS_NROOT}/SystemUpdate/Downloading";
_dir_make "{SYS_NROOT}/SystemUpdate/DeployStore";
_return "ok";


:CheckUpdate;
//Check Update is Latest?

//Get Build Edition
_sipcfg.open "{NATVC_CONFIG_SYSTEM}";
_var {CSU_Update_Edition} = _sipcfg Edition;
_var {CSU_Connection_URL} = _sipcfg CSU_Service_Connection_URL;
_var {CSU_System_version} = _sipcfg SYS_KERNEL_VID;

_file_write "[%time%][CSU] CSU Report System Edition :  {CSU_Update_Edition}   Connection URL :   {CSU_Connection_URL}   System Version :  {CSU_System_version}";
_file_write "[%time%][CSU] Connection Server to getting latest version";

_file_del "{SYS_NROOT}/SystemUpdate/Downloading/catalog.cfg";

