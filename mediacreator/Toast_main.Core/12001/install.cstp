$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/powermenu.ca);
_$directmode;
_$nolog;

_clear;
_cout "What do you want to do";
_cout "    1. Shutdown Device";
_cout "    2. Restart Device";
_cout "    3. Switch User";
_cout "    4. Logoff User";
_cout "";
_cout "    Other command please view help document";
_cout "    Press [Enter] to Back";
_cout "";
_cout "Advanced Power Menu";
_var {pwMenu} = _getline;
_if(_cp("{pwMenu}","1"))|_return "shutdown";
_if(_cp("{pwMenu}","2"))|_return "restart";
_if(_cp("{pwMenu}","3"))|_return "lock";
_if(_cp("{pwMenu}","4"))|_return "logoff";
_if(_cp("{pwMenu}","r"))|_script <"{SYS_ROOT}/ntvrebl.ca">;
_if(_cp("{pwMenu}","r"))|_return "user_restart";
_if(_cp("{pwMenu}","b"))|_var bvm_bm = "true";
_if(_cp("{pwMenu}","b"))|_return "user_restart";
_if(_cp("{pwMenu}","s"))|_var {boot_rsmode} = "true";
_if(_cp("{pwMenu}","s"))|_return "user_restart";


_if(_cp("{pwMenu}",".rs"))|_goto :rs_restart;
_if(_cp("{pwMenu}",".bm"))|_goto :bm_restart;
_if(_cp("{pwMenu}",".re"))|_goto :GORECOVERY;
_if(_cp("{pwMenu}",".adv"))|_goto :LoadAdvancedBootOpt;
_if(_cp("{pwMenu}","bootopt"))|_goto :RunBootOPT;
_return "ok";


//Extend Command

:rs_restart;
//Restart and Open Root Shell
