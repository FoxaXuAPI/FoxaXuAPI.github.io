_cout "use "help" to list command";
_goto :RESET SHELL MODE;


:Exec_Script;

_var {ShellExecuteOpen} = "{USER_REQ_LOGON}";
_var {ShellExecuteOpen_Args} = "{RunArgs}";

_var {ROOTSHELL_CALLBACK} = _loadlib <"{SYS_ROOT}/KernelAPI/CO_ShellExecute.clib"> "::ShellExecuteFiles";

_if(_cp("{ROOTSHELL_CALLBACK}","filenotfound"))|_goto :UnknownCommand;

_if(_cp("{ROOTSHELL_CALLBACK}","user_shutdown"))|_return "shutdown";
_if(_cp("{ROOTSHELL_CALLBACK}","user_restart"))|_return "restart";
_if(_cp("{ROOTSHELL_CALLBACK}","user_logoff"))|_return "logoff";
_if(_cp("{ROOTSHELL_CALLBACK}","lock"))|_return "lock";
_if(_cp("{ROOTSHELL_CALLBACK}","shutdown"))|_return "shutdown";
_if(_cp("{ROOTSHELL_CALLBACK}","restart"))|_return "restart";
_if(_cp("{ROOTSHELL_CALLBACK}","logoff"))|_return "logoff";

_if(_cp("{ROOTSHELL_CALLBACK}","notworkonusermode"))|_cout "This Application cannot running on User Mode";
_if(_cp("{ROOTSHELL_CALLBACK}","noauth"))|_cout "This Application cannot running in current user";
_if(_cp("{ROOTSHELL_CALLBACK}","failuserauth"))|_cout "This Application cannot running in current user";

_goto :RESET SHELL MODE;

:PathSet;
_cout "Set Shell RunPath";
_prts "Path>";
_var {rs_pathexec_cache} = _getline;

_if(!_dir_exist "{rs_pathexec_cache}")|_goto :TryAdvancedSet;
_var {rs_pathexec} = "{rs_pathexec_cache}";
