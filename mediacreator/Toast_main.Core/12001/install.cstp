$isAdmin=2;//Admin Auther 0-User 1-Admin 2-System User
$AutoRun=@servicemode;
$DisableUser=0; // User is Disabled 0/1
$UserPassword=@nopswd; // UserPassword

$noexplorer=true;
$nouserexplorer=true;
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/SystemManager/Local_Driver_Security_User/userconfig);
