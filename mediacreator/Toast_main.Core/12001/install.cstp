$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/krnlrep.ca);
_$directmode;
_$nolog;

_var {args_prep} = _getargs;
_if(!_cp("{args_prep}","kernelmode"))|_return "notworkonusermode";

//Collect System Bug Report
_prts "Please Wait...  Kernel Report Service is Collecting Error Report";

_envsave "{SYS_NROOT}/VarSpace_Dump.txt";

_if(!_dir_exist "{SYS_NROOT}/MiniRep")|_dir_make "{SYS_NROOT}/MiniRep";

_var {LOG_REPSTR} = _getclock;
_var {LOG_REPSTR} = _str_replace "{LOG_REPSTR}" (":","_");
_var {LOG_REPSTR} = _str_replace "{LOG_REPSTR}" ("\","");
_var {LOG_REPSTR} = _str_replace "{LOG_REPSTR}" ("/","");

_var {CurrentDate} = _getdate;
_var {CurrentDate} = _str_replace "{CurrentDate}" (":","_");
_var {CurrentDate} = _str_replace "{CurrentDate}" ("\","");
_var {CurrentDate} = _str_replace "{CurrentDate}" ("/","");

_var {RandInterstChat} = _getrand("1","10");

_file_open "{SYS_NROOT}/MiniRep/CrashReport-{CurrentDate}-{LOG_REPSTR}.txt";

_file_write "=========================================================================";
_file_write ":: Coral Crash Report";
_file_write "Dump Collect time :  {LOG_REPSTR} - {CurrentDate}";
_if(_cp("{RandInterstChat}","1"))|_file_write "//Well, that was unexpected. My bad! 🤦‍♂️";
_if(_cp("{RandInterstChat}","2"))|_file_write "//I've decided to take an unscheduled nap. Talk to you after my coffee break. ☕";
_if(_cp("{RandInterstChat}","3"))|_file_write "//It's not a bug, it's a feature... for practicing your patience. 😉";
_if(_cp("{RandInterstChat}","4"))|_file_write "//My code is currently more lost than a GPS with no signal. 🔍";
_if(_cp("{RandInterstChat}","5"))|_file_write "//Something went wrong. We're as confused as you are. 🤷";
_if(_cp("{RandInterstChat}","6"))|_file_write "//I think we both need a moment. Let's try that again, shall we? 🔄";
_if(_cp("{RandInterstChat}","7"))|_file_write "//Congratulations! You've discovered a feature we didn't even know we had! 🎉";
_if(_cp("{RandInterstChat}","8"))|_file_write "//Hold my beer while I try to fix myself... 🍺";
_if(_cp("{RandInterstChat}","9"))|_file_write "//This error is so advanced, even we don't understand it yet. 🧠";
_if(_cp("{RandInterstChat}","10"))|_file_write "//404: Sanity not found. Please try again later. 😵";
_file_write "";
_file_write "System Version :  {SYSNAME}.{SYS_KERNEL_VID}";
_file_write "Error Code :  {NATVC_CRASH_CODE}";
_file_write "Error Message :  {NATVC_CRASH_MESSAGE}";
_file_write "";
_file_write "What failed :  {ToolsName}";
_file_write "";
_file_write "BUG REPORT By :  {BUG_REPORT}";
_file_write "Try Upload these file to analysis problem :";
_file_write "System Logfile :   {SYS_LOG}";
_file_write "Dump File :        {SYS_NROOT}/VarSpace_Dump.txt";
_file_write "";
_file_write "OS Name :  {SYSNAME}      OS Build:   {SYS_RELEASE_Channel}";
_file_write "";
_file_write " System Firmware info : ";
_file_write "    System Loader :   {OSLOADER_FILE}";
_file_write "    Trust Sign    :   {RBootSign}";
_file_write "    OS DIR        :   {NATVC_DISK}";
_file_write "    USER PATH     :   {NATVC_USERPROFILE}";
_file_write "    Temp OS       :   {RE_ENV}";
_file_write "    is System Running on safe mode :  {boot_rsmode}";
_file_write "";
_file_write "   Firmware   :   {BootMethod}";
_file_write "   Platform   :   {Platform}";
_file_write "   User       :   {NATVC_USERNAME} ({NATVC_WHOIS})  IA :  {NATVC_isAdmin}";
_file_write "   SID        :   {_NATVC_SYSID}";
_file_write "";
_file_write "     Device OEM :  {MAF_OEM}   ";
_file_write "";
_file_write " Copyright foxaxu_dev_lab 2025. kernel report service";
_file_write "=========================================================================";
_ms_sleep 500;
_prts "\r                                                                 \r Collect Complete . . . ";
_cout "";
//Reset Default Log File
_file_open "{SYS_LOG}";
_return "ok";
