$CSTP_FILE_RECORD_MARK_ID_START(/Coral/confedit.ca);
_$directmode;
_$nolog;

_var {COV_ARGS} = _getargs;

_cover <"{SYS_ROOT}/confedit.ca"> "{COV_ARGS}";

_cout "Invoke App failed. Use sysfix to repair this system";

_return "ok";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/confedit.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/config/DeploySettings);
//Natvc Deploy Settings For System first startup

//Allow Not System user run this service
$AllowAdminUserDebug=false;

//deploy system
$ModernDeployService=true;

//For Insider Version System Unlock Administrator
$AutoUnlockAdminUser=false;

//Debug settings
$CreateUserOOBE=true;

//Modify config/SETUP oobe = 0
$ModifySetupOOBEtoZero=true;

//Enable Fast Boot when system complete deploy
$EnableFastBoot=true;

$FILECHECK=true;
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/config/DeploySettings);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/config/PRODUCT);
//NATVC PRODUCT LICENSE ID
$Product=Standard Edition;
$ProductID=ALL_VERSION;
$ActivateRequireID=SE_LC;
$ProductActivateRequire=true;

$ActivateServer=http://githubimage.foxaxu.top/product/register/personal;
$EnforceNetworkActivate=true;

$TimeBomb=0;
$RejectLoginForTimeBomb=false;

$FILECHECK=true;
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/config/PRODUCT);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/config/SETUP);
//NATVC SETUP ADVANCED
$oobe=1;
$oobe_pending_restart=1;
$ModernAppReady=0;
$SystemDeploy={SYS_ROOT}/oobe/crodeploy.ca;
$callexec={SYS_ROOT}/oobe/fxoobe.ca;
$oobequick=0;

//Shutdown Record  0 - false    1 - true
$shutdown_record=1;
$SystemRE_Status=false;
$SystemRE_Dir={NoReEnv};
$FastBoot=0;
$RestartExecuteMemReset=1;


//SysRepairService
$DisableSysRepiar=true;

//BootDebug
$DebugNoGUIBoot=0; //set 1 to print boot message. set 0 to display normal boot screen

//Shutdown Status
$shutdown=0;
$last_startup=0;
$last_shutdown=0;

//Explorer
$explorer_title=$SHELL & EXPLORER>;

//NTVANI
$offani=false;

//Command Manager
$whitelist=0;
$whitelist_file={NATVC_CONFIG}/WHITE_LIST;

//Kernel
$EnableSystemUserProtection=true;
$EnableNatvcDebugReport=false;

//System Secure Settings
$NATVC_BOOT_DLOAD=1;
$NATVC_SHUTDOWN_SECURE=0;  //Set 1 Enabled . 0 Disabled.
$NATVC_CRASH_EXECUTE=$reboot;  //Set $shutdown or $reboot . 
$NATVC_CRASH_AUTOREBOOT=0;
$NATVC_CRASH_AUTOREBOOT_TIME=15;

//Activate
$IsSystemActivated=false;
$ActivateVaildTime=0;

//Shutdown Execute
$shutdown_execute=noexec;
$shutdown_exe_title=Please Wait. Prepare Update;

//Startup Execute
$startup_execute=noexec;
$startup_exe_title=Prepare Update ;

//ALL DATA
$FILECHECK=true;
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/config/SETUP);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/config/SOFTWARE);
//NATVC SOFTWARE PATH BIND
//NATVC SOFTWARE GET

//Software Register Link


//For Support Legacy app
$FILECHECK=true;
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/config/SOFTWARE);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/config/SYSTEM);
//NATVC SYSTEM CONFIG
//Log Record

//WARNING:  THIS CONFIG FILE IS SYSTEM FILE
//changes may cause system fail to boot.

//LogFile
$NATVC_SYS_LOG=Coral/LogFile; //This Record IS logfile path
//Debug Switch is move to SETUP

//MAIN
//System boot will check bootloader file is credible
$BL_TrustCheck=false;    

$Edition=Toast_main.Core;

//PATH BIND
$SYS_ROOT={Boot_OSPATH}/System;  //SYSTEM ROOT PATH
$SYS_NROOT={Boot_OSPATH};        //Natvc System Path
$PROG_PATH=Program;      //Natvc Program Path
$SYS_USERDIR=Users;      //Natvc User Path Bind


//System Messagex
$SYS_NAME=Coral;
$SYS_KERNEL_VID=12001;
$SYS_REG_NAME=1.0;
$SYS_KERNEL_CODENAME=Toast;
$SYS_RELEASE_Channel=26H2;
$SYS_BASE_VID=FoxaXuDevLab(R):Coral(R).1_0.26H2.Toast:Pre_Release(RP1);

//System Index Kernel File
$NATVC_USERSVC=usersvc.ca;
$NATVC_USERMENU=usermenu.ca;
$NATVC_ROOTSHELL=rootshell.ca;
$NATVC_EXPLORER=ntvexp.ca;

//Resource File
$NATVC_ABOUTS_TEXT={SYS_NROOT}/res/natvc-abouts.txt;
$NATVC_CRASH_TEXT=Coral/res/natvc-crash.txt;

//End
$FILECHECK=true;
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/config/SYSTEM);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/config/USERS);
//PUBLIC USER DATA
//USERPATH DIR
$default=@;
$defaultPassword=@;

//WARNING:  THIS CONFIG FILE IS SYSTEM FILE
//changes may cause system fail to boot.

//UserData
//SYSTEM is Kernel User. Do not attempt to modify any settings related to system users.
$SYSTEM=Coral/SystemUser;
$Local_Driver_Security_User=Coral/SystemManager/Local_Driver_Security_User;

//admin is default system admin user
$admin=Users/admin;

//Add User
$FILECHECK=true;
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/config/USERS);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/config/WHITE_LIST);
//CONFIG USER ALLOW EXECUTE
$pm=true;
${varspace.null}=true;
$help=true;
$.exit=true;
$exit=true;
$reload=true;
$logoff=true;
$hiber=true;
$shutdown=true;
$@shutdown=true;
$restart=true;
$lock=true;
$ls=true;
$clear=true;
$path=true;
$return=true;
$about=true;
$aboutsys=true;
$whoami=true;
$menu=true;
$software=true;
$ok=true;
$update=true;
$explorer=true;
$rootshell=true;
$args=true;
$run=true;
$shell=true;
$rshell=true;

//Others
$FILECHECK=true;
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/config/WHITE_LIST);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/CoralApps/$SystemAppRoot.txt);
SystemApps Root Folder
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/CoralApps/$SystemAppRoot.txt);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/explorer.ca);
_$directmode;
_$nolog;

_var {COV_ARGS} = _getargs;

_cover <"{SYS_ROOT}/explorer.ca"> "{COV_ARGS}";

_cout "Invoke App failed. Use sysfix to repair this system";

_return "ok";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/explorer.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/mnacore/about.txt);
Modern App Core
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/mnacore/about.txt);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/mnacore/checkexist.ca);
_$directmode;
_$nolog;

_var {LoadApp} = _getargs;

_var {AppDir} = "{SYS_NROOT}/CoralApps/{LoadApp}";


_if(_dir_exist "{AppDir}")|_return "true";

_if(!_dir_exist "{AppDir}")|_var {AppDir} = "{PROG_PATH}/{LoadApp}";

_if(_dir_exist "{AppDir}")|_return "true";

_if(!_dir_exist "{AppDir}")|_goto :NoThisApps;


:NoThisApps;
_return "false";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/mnacore/checkexist.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/mnacore/install.ca);
_$directmode;
_$nolog;

_if(_cp(_sipcfg nomodernapp,"true"))|_file_write "[Mna_Install] Current User is disabled ModernApp";
_if(_cp(_sipcfg nomodernapp,"true"))|_return "ModernAppRequestFailed:Disabled";
_if(_cp("{IsSystemRunningOnSafeMode}","1"))|_file_write "[Mna_Install] Modern App not allowed running on safemode";
_if(_cp("{IsSystemRunningOnSafeMode}","1"))|_return "ModernAppRequestFailed:SafeModeBlocked";
_if(_cp("{boot_rsmode}","true"))|_file_write "[Mna_Install] Modern App not allowed running on safemode";
_if(_cp("{boot_rsmode}","true"))|_return "ModernAppRequestFailed:SafeModeBlocked";


//mna app installer tool
//Install Main Service
_file_open "{SYS_LOG}";
_file_write "[Mna_Service] Install Request...";

_var {Req_install_dev} = _getargs;

_file_write "[Mna_Service] Parameter {Req_install_dev}";

_if(!_file_exist "{Req_install_dev}")|_goto :P1;
_if(_file_exist "{Req_install_dev}")|_goto :P3;
:P2
_if(!_file_exist "{Req_install_dev}")|_goto :FailReqApp;
:P3;

//start setup application
//Config Program Dir

_if(_cp("0","{NATVC_isAdmin}"))|_goto :NoAuthPkgInstaller;


//Start app
//MKDIR
_$no_cstp_output;
_file_uncstp ("{Req_install_dev}","{temp}/mnaAppTemp");
_$open_cstp_output;

//Decode package
_sipcfg.open "{temp}/mnaAppTemp/pkgdata.mna";
_var {pkgSetupName} = _sipcfg Setup;
_var {pkgAppName} = _sipcfg AppName;
_var {pkgAppProperties} = _sipcfg AppProperties;

_free {mna_pdir};

_if(_cp ("systemapps","{pkgAppProperties}") ) |_var {mna_pdir} = "{SYS_NROOT}/CoralApps";
_if(_cp ("userapps","{pkgAppProperties}")   )   |_var {mna_pdir} = "{PROG_PATH}";

_if(_dir_exist "{mna_pdir}/{pkgSetupName}")|_goto :RemoveTry;

:StartCopy;
//_file_uncstp ("{Req_install_dev}","{mna_pdir}/{pkgSetupName}");
_var {XCOPY_A} = "{temp}/mnaAppTemp";
_var {XCOPY_B} = "{mna_pdir}/{pkgSetupName}";
_script <"{SYS_ROOT}/xcopy.ca">;
_free {XCOPY_A};
_free {XCOPY_B};

_if(!_dir_exist "{SYS_NROOT}/SystemAppPackages")|_dir_make "{SYS_NROOT}/SystemAppPackages";
_if(!_dir_exist "{PROG_PATH}/AppPackages")      |_dir_make "{PROG_PATH}/AppPackages";


_if(_cp ("systemapps","{pkgAppProperties}") )   |_file_copy ("{Req_install_dev}","{SYS_NROOT}/SystemAppPackages/{pkgSetupName}");";
_if(_cp ("userapps","{pkgAppProperties}")   )   |_file_copy ("{Req_install_dev}","{PROG_PATH}/AppPackages/{pkgSetupName}");";

//_cout "Save Succeed :  {mna_pdir}/{pkgSetupName}";

_dir_remove "{temp}/mnaAppTemp";

_file_open "{SYS_LOG}";
_file_write "[Mna_Service] App Setup Succeed :  {pkgAppName}   Tag ;  {pkgAppProperties}   Path :  {mna_pdir}";
_file_write "[Mna_Service] Install Operate User :  {NATVC_WHOIS},  User Auth :  {NATVC_isAdmin},";
_cout "App Setup Succeed :  {pkgAppName}   Tag ;  {pkgAppProperties}   Path :  {mna_pdir}";
//_cout "Log File :   {SYS_LOG}";
_$open_cstp_output;
_return "ok";


:FailReqApp;
_cout " mna install serivces";
_cout " invaild package :  {Req_install_dev}";
_cout " Check your type or repiar this file";
_return "failinst";

:NoAuthPkgInstaller;
_cout " mna install serivces";
_cout " Current User is not allowed to install this app";
_cout " Use your administrator user try again";
_return "failinst";


:P1;
_var {Req_install_dev} = "{SYS_NROOT}/SystemAppPackages/{Req_install_dev}";
_if(!_file_exist "{Req_install_dev}")|_var {Req_install_dev} = "{PROG_PATH}/AppPackages/{Req_install_dev}";
_goto :P2;


:RemoveTry;
_cout "App :  {pkgSetupName} is already installed on this device. Trying to uninstall this apps";
_var {tempargs} = _script <"{SYS_NROOT}/mnacore/uninstallenf.ca"> "{pkgSetupName}";
_if(_cp("{tempargs}","false_pendingreboot"))|_goto :FailedRemoveOldVersionOfApp;
_cout "Uninstall succeed.";
_goto :StartCopy;

:FailedRemoveOldVersionOfApp;
_cout "WARNING!  App :  {pkgSetupName}  is working and cannot uninstalled. This apps will be updated on system restart!";

_dir_make "{SYS_NROOT}/SystemUser/AppData/modernapp.installer.mna";
_var {PackageNameNew} = _getrand("10000000","90000000");
_var {PackageNameNew} = "{PackageNameNew}.mna";
_file_copy ("{Req_install_dev}","{SYS_NROOT}/SystemUser/AppData/modernapp.installer.mna/{PackageNameNew}");

_file_open "{SYS_NROOT}/SystemUser/TaskUserExecute/task.ca";
_file_write "_script <"{SYS_NROOT}/mnacore/install.ca"> "{SYS_NROOT}/SystemUser/AppData/modernapp.installer.mna/{PackageNameNew}"; ";
_file_write "_file_del "{SYS_NROOT}/SystemUser/AppData/modernapp.installer.mna/{PackageNameNew}"; ";

_file_open "{SYS_LOG}";
_return "true";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/mnacore/install.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/mnacore/mnaload.ca);
_$directmode;
_$nolog;

_sipcfg.open "{NATVC_USERPROFILE}/userconfig";
_if(_cp(_sipcfg nomodernapp,"true"))|_file_write "[Mna_service] Current User is disabled ModernApp";
_if(_cp(_sipcfg nomodernapp,"true"))|_return "ModernAppRequestFailed:Disabled";
_if(_cp("{IsSystemRunningOnSafeMode}","1"))|_file_write "[Mna_service ML 1] Modern App not allowed running on safemode";
_if(_cp("{IsSystemRunningOnSafeMode}","1"))|_return "ModernAppRequestFailed:SafeModeBlocked";
_if(_cp("{boot_rsmode}","true"))|_file_write "[Mna_service ML 2] Modern App not allowed running on safemode";
_if(_cp("{boot_rsmode}","true"))|_return "ModernAppRequestFailed:SafeModeBlocked";

_var {LoadApp} = _getargs;

_var {AppDirTemp} = "{SYS_NROOT}/CoralApps/{LoadApp}";
_var {AppDataTemp} = "{NATVC_USERPROFILE}/AppData/{LoadApp}";

_if(!_dir_exist "{AppDirTemp}")|_var {AppDirTemp} = "{PROG_PATH}/{LoadApp}";

_if(!_dir_exist "{AppDirTemp}")|_goto :UseMethod;

_var {AppDir} = {AppDirTemp};
_var {AppData} = {AppDataTemp};
_free {AppDirTemp};
_free {AppDataTemp};


_file_write "[Mna_service] Appload on {AppDir}";

_if(!_file_exist "{AppDir}/apploader.ca")|_goto :BreakPackage;

_if(!_dir_exist "{NATVC_USERPROFILE}/AppData")|_dir_make "{NATVC_USERPROFILE}/AppData";
_if(!_dir_exist "{AppData}")|_dir_make "{AppData}";
_file_write "[Mna_service] Execute Program :   {AppDir}/apploader.ca";

_var {mna_loader_callback} = _script <"{AppDir}/apploader.ca">;

_return "{mna_loader_callback}";



:UseMethod;
_cout "Unable Load this app :  {LoadApp}";
_pause;
_return "failLdr";

:BreakPackage;
_cout "Unable Load this app :  {LoadApp}";
_cout "This app package might be break. try to reinstall this application";
_pause;
_return "failLdr";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/mnacore/mnaload.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/mnacore/pkgexist.ca);
_$directmode;

_sipcfg.open "{NATVC_USERPROFILE}/userconfig";
_if(_cp(_sipcfg nomodernapp,"true"))|_file_write "[Mna_Package] Current User is disabled ModernApp";
_if(_cp(_sipcfg nomodernapp,"true"))|_return "ModernAppRequestFailed:Disabled";
_if(_cp("{IsSystemRunningOnSafeMode}","1"))|_file_write "[Mna_Package] Modern App not allowed running on safemode";
_if(_cp("{IsSystemRunningOnSafeMode}","1"))|_return "ModernAppRequestFailed:SafeModeBlocked";
_if(_cp("{boot_rsmode}","true"))|_file_write "[Mna_Package] Modern App not allowed running on safemode";
_if(_cp("{boot_rsmode}","true"))|_return "ModernAppRequestFailed:SafeModeBlocked";


_var {Parameter} = _getargs;

_if(_file_exist "{SYS_NROOT}/CoralApps/{Parameter}/pkgdata.mna")|_return "true";
_if(_file_exist "{PROG_PATH}/{Parameter}/pkgdata.mna")|_return "true";
_return "false";

//Ret
:R_T;
_return "true";

:R_F;
_return "false";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/mnacore/pkgexist.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/mnacore/pkgSaved.ca);
_$directmode;
_$nolog;

//mna app out toolkit
// for debug tool

:startuninst;
_var {LoadApp} = _getargs;

_var {AppDir} = "{SYS_NROOT}/CoralApps/{LoadApp}";

_if(!_dir_exist "{AppDir}")|_var {AppDir} = "{PROG_PATH}/{LoadApp}";

_if(!_dir_exist "{AppDir}")|_goto :UseMethod;

_cout "Type Save Path";
_prt "savefile >";
_var {SavedFile} = _getline;

_cout "";
_cout "Please wait ... ";
_file_cstp ("{AppDir}","{SavedFile}");
_file_open "{SYS_LOG}";
_cout "App Out File Succeed :  {LoadApp}";
_cout "On File :  {SavedFile}";
_return "ok";

:UseMethod;
_cout "Request Out package App fail :  {LoadApp}";
_cout "method :   pkgSaved.ca     Args = App";
_cout "Press any key to exit";
_pause;
_return "failLdr";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/mnacore/pkgSaved.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/mnacore/quickload.ca);
_$directmode;
_$nolog;

_sipcfg.open "{NATVC_USERPROFILE}/userconfig";
_if(_cp(_sipcfg nomodernapp,"true"))|_file_write "[Mna_service] Current User is disabled ModernApp";
_if(_cp(_sipcfg nomodernapp,"true"))|_return "noapp";
_if(_cp("{IsSystemRunningOnSafeMode}","1"))|_file_write "[Mna_service QL 1] Modern App not allowed running on safemode";
_if(_cp("{IsSystemRunningOnSafeMode}","1"))|_return "noapp";
_if(_cp("{boot_rsmode}","true"))|_file_write "[Mna_service QL 2] Modern App not allowed running on safemode";
_if(_cp("{boot_rsmode}","true"))|_return "noapp";

_var {LoadApp} = _getargs;

_var {AppDirTemp} = "{SYS_NROOT}/CoralApps/{LoadApp}";
_var {AppDataTemp} = "{NATVC_USERPROFILE}/AppData/{LoadApp}";

_if(!_dir_exist "{AppDirTemp}")|_var {AppDirTemp} = "{PROG_PATH}/{LoadApp}";

_if(!_dir_exist "{AppDirTemp}")|_goto :UseMethod;

_var {AppDir} = {AppDirTemp};
_var {AppData} = {AppDataTemp};
_free {AppDirTemp};
_free {AppDataTemp};

_file_write "[Mna_service] Appload on {AppDir}";

_if(!_file_exist "{AppDir}/apploader.ca")|_goto :BreakPackage;

_if(!_dir_exist "{NATVC_USERPROFILE}/AppData")|_dir_make "{NATVC_USERPROFILE}/AppData";
_if(!_dir_exist "{AppData}")|_dir_make "{AppData}";
_file_write "[Mna_service] Execute Program :   {AppDir}/apploader.ca";

_var {mna_loader_callback} = _script <"{AppDir}/apploader.ca">;

_return "{mna_loader_callback}";



:UseMethod;
_return "noapp";

:BreakPackage;
_cout "Unable Load this app :  {LoadApp}";
_cout "This app package might be break. try to reinstall this application";
_pause;
_return "failLdr";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/mnacore/quickload.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/mnacore/rmall.ca);
_$directmode;
_$nolog;

_cout "";
_cout "Removing all modern apps";

_var {IntLoad_ForMNA_R} = "1";

//Add New Package list files
_file_del "{NATVC_CONFIG}/mnalist";

_dir_list ("{NATVC_CONFIG}/mnalist","{SYS_NROOT}/SystemPackage");
_file_replace "{NATVC_CONFIG}/mnalist" ("{SYS_NROOT}/SystemPackage/","");


:MNARESETRESCAN;
_var {ReadCache} = _file_read ("{NATVC_CONFIG}/mnalist","{IntLoad_ForMNA_R}");

_if(_cp("{ReadCache}","FileNotExist"))|_goto :FailAddsPkgList;

_if(_cp("{ReadCache}","overline")) | _goto :MNARESETRESCAN_OK;

//Verify
_file_write "[RestoreMNA] Restore Package :  {ReadCache}";

//_cout "Restore package {SYS_NROOT}/SystemPackage/{ReadCache}";
_cout "";
_cout "Progress Restore... {IntLoad_ForMNA_R}    Please wait";

_if(!_file_exist "{SYS_NROOT}/SystemPackage/{ReadCache}")|_goto :MNA_NullPackRestore;

_script <"{SYS_NROOT}/mnacore/uninstallenf.ca"> "{ReadCache}";

:BACKCTRESTORE;

_var {IntLoad_ForMNA_R} = _+("{IntLoad_ForMNA_R}","1");
_goto :MNARESETRESCAN;

:MNARESETRESCAN_OK;
//complete MNA Restore
_cout "";
_cout "";
_cout "Restarting your device.";
_file_del "{NATVC_CONFIG}/mnalist";
_return "user_restart";

:FailAddsPkgList;
_cout "";
_cout "App cannot installed because package list is missing";
_cout "";
_return "ok";

:MNA_NullPackRestore;
_cout "";
_cout "App cannot be installed because package {ReadCache} not found";
_goto :BACKCTRESTORE;

//LL
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/mnacore/rmall.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/mnacore/uninstall.ca);
_$directmode;
_$nolog;

_if(_cp(_sipcfg nomodernapp,"true"))|_file_write "[Mna_Uninstall] Current User is disabled ModernApp";
_if(_cp(_sipcfg nomodernapp,"true"))|_return "ModernAppRequestFailed:Disabled";
_if(_cp("{IsSystemRunningOnSafeMode}","1"))|_file_write "[Mna_Uninstall] Modern App not allowed running on safemode";
_if(_cp("{IsSystemRunningOnSafeMode}","1"))|_return "ModernAppRequestFailed:SafeModeNull";
_if(_cp("{boot_rsmode}","true"))|_file_write "[Mna_Uninstall] Modern App not allowed running on safemode";
_if(_cp("{boot_rsmode}","true"))|_return "ModernAppRequestFailed:SafeModeNull";

//mna app uninstaller tool
//Uninstall Main Service
_file_open "{SYS_LOG}";
_file_write "[Mna_Service] Uninstall Request...";

//start setup application
//Config Program Dir


_if(_cp("2","{NATVC_isAdmin}"))|_goto :startuninst;
_if(_cp("1","{NATVC_isAdmin}"))|_goto :startuninst;
_cout "This user is not allowed to uninstall any app";
_return "noauth";


//Start app
//MKDIR
:startuninst;
_var {LoadApp} = _getargs;

_file_open "{SYS_LOG}";
_file_write "[Mna_Service] Parameter {LoadApp}";

_var {AppDir} = "{SYS_NROOT}/CoralApps/{LoadApp}";
_var {AppSource} = "{SYS_NROOT}/SystemAppPackages/{LoadApp}";

_if(!_dir_exist "{AppDir}")|_var {AppDir} = "{PROG_PATH}/{LoadApp}";
_if(!_file_exist "{AppSource}")|_var {AppSource} = "{PROG_PATH}/AppPackages/{LoadApp}";


_if(!_dir_exist "{AppDir}")|_goto :UseMethod;

_dir_remove "{AppDir}";
_if(_dir_exist "{AppDir}")|_goto :Use Second TaskRemove;

_file_del "{AppSource}";


_file_open "{SYS_LOG}";
_file_write "[Mna_Service] App Uninstall Succeed :  {LoadApp}";
_file_write "[Mna_Service] Uninstall Operate User :  {NATVC_WHOIS},  User Auth :  {NATVC_isAdmin},";
_cout "App Uninstall Succeed :  {LoadApp}";

_return "ok";

:UseMethod;
_cout "Modern App Deploy & Manager";
_cout "Request Uninstall App Not Found :  {LoadApp}";
_cout "method :   uninstall.ca     Args = App";
_cout "Press any key to exit";
_return "failLdr";

:Use Second TaskRemove;
_file_write "[Mna_Service][Error] App Uninstall Failed :  {LoadApp}";
_cout "Failed uninstall {AppDir}";
_cout "Use uninstallenf.ca to remove this application force";
_return "false";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/mnacore/uninstall.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/mnacore/uninstallenf.ca);
_$directmode;
_$nolog;

_if(_cp(_sipcfg nomodernapp,"true"))|_file_write "[Mna_Uninstall] Current User is disabled ModernApp";
_if(_cp(_sipcfg nomodernapp,"true"))|_return "ModernAppRequestFailed:Disabled";
_if(_cp("{IsSystemRunningOnSafeMode}","1"))|_file_write "[Mna_Uninstall] Modern App not allowed running on safemode";
_if(_cp("{IsSystemRunningOnSafeMode}","1"))|_return "ModernAppRequestFailed:SafeModeNull";
_if(_cp("{boot_rsmode}","true"))|_file_write "[Mna_Uninstall] Modern App not allowed running on safemode";
_if(_cp("{boot_rsmode}","true"))|_return "ModernAppRequestFailed:SafeModeNull";

//mna app uninstaller tool
//Uninstall Main Service
_file_open "{SYS_LOG}";
_file_write "[Mna_Service] Uninstall Request...";

//start setup application
//Config Program Dir


_if(_cp("2","{NATVC_isAdmin}"))|_goto :startuninst;
_if(_cp("1","{NATVC_isAdmin}"))|_goto :startuninst;
_cout "This user is not allowed to uninstall any app";
_return "noauth";


//Start app
//MKDIR
:startuninst;
_var {LoadApp} = _getargs;

_file_open "{SYS_LOG}";
_file_write "[Mna_Service] Parameter {LoadApp}";

_var {AppDir} = "{SYS_NROOT}/CoralApps/{LoadApp}";
_var {AppSource} = "{SYS_NROOT}/SystemAppPackages/{LoadApp}";

_if(!_dir_exist "{AppDir}")|_var {AppDir} = "{PROG_PATH}/{LoadApp}";
_if(!_file_exist "{AppSource}")|_var {AppSource} = "{PROG_PATH}/AppPackages/{LoadApp}";


_if(!_dir_exist "{AppDir}")|_goto :UseMethod;

_dir_remove "{AppDir}";
_if(_dir_exist "{AppDir}")|_goto :Use Second TaskRemove;

_file_del "{AppSource}";


_file_open "{SYS_LOG}";
_file_write "[Mna_Service] App Uninstall Succeed :  {LoadApp}";
_file_write "[Mna_Service] Uninstall Operate User :  {NATVC_WHOIS},  User Auth :  {NATVC_isAdmin},";
_cout "App Uninstall Succeed :  {LoadApp}";

_return "ok";

:UseMethod;
_cout "Modern App Deploy & Manager";
_cout "Request Uninstall App Not Found :  {LoadApp}";
_cout "method :   uninstall.ca     Args = App";
_cout "Press any key to exit";
_return "failLdr";

:Use Second TaskRemove;
_file_open "{SYS_LOG}";
_file_write "[Mna_Service] App Uninstall failed :  {LoadApp}. Access Denied";
_file_write "[Mna_Service] Uninstall Operate User :  {NATVC_WHOIS},  User Auth :  {NATVC_isAdmin},";
_cout "App Uninstall Failed :  {LoadApp}  .  This app will be uninstall until system restart&shutdown";

_file_open "{SYS_NROOT}/SystemUser/TaskUserExecute/task.ca";
_file_write "_dir_remove "{AppDir}"; ";
_file_write "_file_del "{AppSource}"; ";

_file_open "{SYS_LOG}";
_return "false_pendingreboot";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/mnacore/uninstallenf.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/mnacore/uninstalllow.ca);
