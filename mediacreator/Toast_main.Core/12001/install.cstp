$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/Kernel/osdatldr.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/Kernel/osldr.ca);
_$directmode;

_if(_cp("{NoGUIBootOpt}","1"))| _cout "Loading {NATVC_CONFIG_SYS}";
