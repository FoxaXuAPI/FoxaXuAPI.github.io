//System Driver Loader
_var {Mem_tmp} = _getargs;
_if(!_cp("{Mem_tmp}","KernelResetMemory"))|_return "failuserauth";

_cout "      Clearing varspace...";

_if(!_file_exist "{NATVC_DISK}/{Boot_OSPATH}/SystemResources/memcollect/exec_memreset.ca")|_return "false";
