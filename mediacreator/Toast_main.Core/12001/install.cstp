//Register License

_var {SLMGR_GETARGS} = _getargs;

//Run Sppsvc
_file_write "[%time%][RegLic] Start services";
_prt "\r                                     \r Register License ...";
_if(_cp("{SPPSVC_PROXY}","true"))|_goto :StartRegister;
_var {UserType} = _script <"{SYS_ROOT}/services.ca"> "sppsvc";
_if(!_cp("{UserType}","true"))|_goto :StartRegister;
_cout "Current System is activated";
_cout "Use slmgr 'remove-license' to remove current license";
_return "true";


:StartRegister;
_prt "\r                                     \r Connection Server";
