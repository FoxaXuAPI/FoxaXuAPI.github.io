_$directmode;
_var {AppName_OnTitle} = "NativeShell";
_var {AppLauncherName} = "CoralModern.NativeShell.mna";
_var {Unexpected_error_feedback} = "exit";
_var {MNAPI_Argument} = _getargs;
_if(_cp("load_old","{MNAPI_Argument}"))|_goto :FailStartupProgram_PKGFALSE;

_if(!_file_exist "{SYS_NROOT}/mnacore/pkgexist.ca")|_goto :FailStartupProgram_PKGFALSE;
_var {Result} = _script <"{SYS_NROOT}/mnacore/pkgexist.ca"> "{AppLauncherName}";
_if(!_cp("{Result}","true"))|_script <"{SYS_NROOT}/mnacore/install.ca"> "{AppLauncherName}";
_var {Result} = _script <"{SYS_NROOT}/mnacore/pkgexist.ca"> "{AppLauncherName}";
_if(!_cp("{Result}","true"))|_goto :FailStartupProgram_PKGFALSE;

_var {appfeedback} = _script <"{SYS_NROOT}/mnacore/mnaload.ca"> "{AppLauncherName}";
_return "{appfeedback}";

:FailStartupProgram_PKGFALSE;
_clear;
_cout "You have not installed Nativeshell. Uninstall or forgot config this application?";
_cout "Go AppInstaller to Install this application";
_cout "Please repair this application. or check system settings";
_pause;
_return "error";
