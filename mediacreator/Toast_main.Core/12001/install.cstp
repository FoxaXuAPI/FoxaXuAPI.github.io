_file_write "[%time%][CoralDeploy] Running Modern Deploy. C:  {DepResult}";

_clear;
_script <"{NATVC_DISK}/$InstallSource/autodeploy.ca">;

_clear;
_var {update_title} = "Finishing system installation";
