_cout "---------------------------------------------------------------";
//MANAGER CONSOLE
_cout "Choose user to do operation. Type exit to close this tool";
_prt "Select User >";
_var {UserType} = _getline;
//PROCESS
_if(_cp("{UserType}","SYSTEM"))|_goto :NoAuthEditThisUser;
_if(_cp("{UserType}","Local_Driver_Security_User"))|_goto :NoAuthEditThisUser;
_if(_cp("{UserType}","TrustedServices"))|_goto :NoAuthEditThisUser;
_if(_cp("{UserType}","Local_Low"))|_goto :NoAuthEditThisUser;

_if(_file_exist "{EXPLORER_WORK_DIR}/{UserType}.nuslc")|_goto :ManageApi;

_if(_cp("{UserType}","exit"))|_return "exit";
_cout "Unknown User";
