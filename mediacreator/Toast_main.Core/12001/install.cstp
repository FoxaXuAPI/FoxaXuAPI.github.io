_if(!_file_exist "{temp}/license_test.txt")|_goto :InvaildKey;
_file_write "[%time%][RegLic] Successfully get license";
_file_copy ("{temp}/license_test.txt","{NATVC_CONFIG}/LICENSE");

_prt "\r                                     \r Trying to Activate your product";
_file_write "[%time%][RegLic] Run Sppsvc";
_if(_cp("{SPPSVC_PROXY}","true"))|_return "sppsvc_check";
_var {UserType} = _script <"{SYS_ROOT}/services.ca"> "sppsvc";

_file_write "[%time%][RegLic] Sppsvc Report a status :  {UserType}";

_if(!_cp("{UserType}","true"))|_goto :VAILDRUNPROCESS;

_var {SYS_ACT_STATUS} = "{UserType}";

_file_write "[%time%][RegLic] Activate Succeed";
_prt "\r                                     \r Product is activated ";
_return "true"

:VAILDRUNPROCESS;
_file_write "[%time%][RegLic] Error with status : {UserType}";
_cout "Software Protection Service Report a problem";
_cout "Code:  {UserType}.   View System log to get more info";
_cout "SLMGR Cannot Running on this product";
_return "false";


:InvaildKey;
