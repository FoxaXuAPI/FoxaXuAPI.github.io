_sipcfg.open "{SYS_NROOT}/config/DeploySettings";

_clear;


:RELOAD_OOBEMAIN;
_var {PRE_AUTOENTRY_PASSWORD} = "@rtoobe";
_var {UserSVCBUFFER} = "KernelModeDetect";

_file_write "[%time%][CoralDeploy] Load OOBE Main";

_var {IsOOBEComplete} = "0";
_var {OOBEDEGBUG} = _script <"{NATVC_USERSVC}"> "oobe";
_file_write "[%time%][CoralDeploy] oobe user is logoff with code :  {OOBEDEGBUG}";

_file_write "[%time%][CoralDeploy] OOBE User Logoff .  status code :  {OOBEDEGBUG}";
_file_write "[%time%][CoralDeploy] OOBE Page Status  : {OOBE_PAGE_STATUS}";
_file_write "[%time%][CoralDeploy] OOBE Complete Status  : {IsOOBEComplete}";

_if(_cp("{OOBE_PAGE_STATUS}","oobe_shutdown"))|_goto :OOBE_CANCEL_PREP;
_if(_cp("{OOBE_PAGE_STATUS}","oobe_recovery"))|_return "oobe_recovery";
_if(_cp("{OOBEDEGBUG}","user_shutdown"))|_return "shutdown";
_if(_cp("{OOBEDEGBUG}","user_restart"))|_return "restart";
_if(_cp("{OOBEDEGBUG}","shutdown"))|_return "shutdown";
_if(_cp("{OOBEDEGBUG}","restart"))|_return "restart";

_file_write "[%time%][CoralDeploy] OOBE Service Closed";

:SkipRunOOBEService;

:EndPageOOBE;
