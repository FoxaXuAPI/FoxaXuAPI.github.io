:NoAuthEditThisUser;
_cout "Sorry This user is not allowed be manage";
_cout "This is System Users";
_pause;
_goto :RELOADCONSOLE;

:ManageApi;
_cout "What Do you want do :";
_cout "User :  {UserType}";
_cout "'lf' - logoff user  'exit' - cancel";
_cout "Choose option";
_prt ">";
_var {UserTypeA} = _getline;
_if(_cp("{UserTypeA}","lf"))|_goto :LOGOFFSUCCEED;
_if(_cp("{UserTypeA}","exit"))|_goto :RELOADCONSOLE;

_goto :ManageApi;

:LOGOFFSUCCEED;
_file_del "{EXPLORER_WORK_DIR}/{UserType}.nuslc";
_if(_cp("{UserType}","{NATVC_WHOIS}"))|_return "user_logoff";
_goto :RELOADCONSOLE;


:FAIL_DISALLOW;
_cout "Up your auth to open this tool";
_pause;
_return "noauth";
