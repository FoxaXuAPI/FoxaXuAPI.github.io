//User Mgr
//Main Console
_$directmode;
//_var {co_ramdisk_mgr.sourcefile} = _getfile;
//_var {co_ramdisk_mgr.processname} = "Coral System Detail Process";
//_var {co_ramdisk_mgr.argument} = "1";
//_loadlib <"{SYS_ROOT}/KernelAPI/CO_RAMDISK_MGR.clib"> "::Auto_Hang_To_Ramdisk";

