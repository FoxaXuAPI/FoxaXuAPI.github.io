_free {DepResult_B};

_return "Complete";

:OOBE_CANCEL_PREP;
//Delete OOBE
_file_write "[%time%][CoralDeploy] User Select Cancel :  OOBE Prep";
_var _ARGS_NU_FULLNAME = "defaultuser";
_var _ARGS_NU_ID = "oobe";
_var _ARGS_NU_PSWD = "@rtoobe";
_var _ARGS_NU_ADMIN = "1";

