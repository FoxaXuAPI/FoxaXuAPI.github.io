_if(!_cp("{EnableNatvcDebugReport}","true"))|_dir_remove "{NATVC_DISK}/$InstallSource";

:SkipDeployModernWithReady;
:SkipInstallSystemMNA;

_sipcfg.open "{NATVC_CONFIG_SETUP}";
_var {tempargs} = _sipcfg oobe_pending_restart;
_if(_cp("{tempargs}","1"))|_sipcfg oobe_pending_restart = "0";
