$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/mnareset.ca);
_$directmode;
_$nolog;

_cout "Processing.... ";

_var {GetAdvProc} = _getargs;
_if(_cp("{GetAdvProc}","uninstallforce"))|_goto :VaildARGS;
_if(_cp("{GetAdvProc}","uninstallonly"))|_goto :VaildARGS;
_if(_cp("{GetAdvProc}","installonly"))|_goto :VaildARGS;
_if(_cp("{GetAdvProc}","reinstall"))|_goto :VaildARGS;
_cout "Modern App Manager      Invaild Argument";
_cout "Argument :  ";
_cout "           mnareset.ca <reinstall/installonly/uninstallonly/uninstallforce>";
_cout "";
_return "ok";

:VaildARGS;
_var {IntLoad_ForMNA_R} = "1";

//Add New Package list files
_file_del "{NATVC_CONFIG}/mnalist";

_dir_list ("{NATVC_CONFIG}/mnalist","{SYS_NROOT}/SystemAppPackages");
_dir_list ("{NATVC_CONFIG}/mnalist","{PROG_PATH}/AppPackages");
_file_replace "{NATVC_CONFIG}/mnalist" ("{SYS_NROOT}/SystemAppPackages/","");
_file_replace "{NATVC_CONFIG}/mnalist" ("{PROG_PATH}/AppPackages/","");

_dir_list ("{NATVC_CONFIG}/mnalist_source","{SYS_NROOT}/SystemAppPackages");
_dir_list ("{NATVC_CONFIG}/mnalist_source","{PROG_PATH}/AppPackages");

:MNARESETRESCAN;
_var {ReadCache} = _file_read ("{NATVC_CONFIG}/mnalist","{IntLoad_ForMNA_R}");
_var {ReadCache_FILEAD} = _file_read ("{NATVC_CONFIG}/mnalist_source","{IntLoad_ForMNA_R}");

_if(_cp("{ReadCache}","FileNotExist"))|_goto :FailAddsPkgList;

_if(_cp("{ReadCache}","overline")) | _goto :MNARESETRESCAN_OK;

//Verify
_file_write "[RestoreMNA] Restore Package :  {ReadCache_FILEAD}";

_cout "";
_cout "Progress Restore... {IntLoad_ForMNA_R}    Please wait";

_if(!_file_exist "{ReadCache_FILEAD}")|_goto :MNA_NullPackRestore;

_if(_cp("{GetAdvProc}","uninstallforce"))|_script <"{SYS_NROOT}/mnacore/uninstallenf.ca"> "{ReadCache}";
_if(_cp("{GetAdvProc}","uninstallforce"))|_goto :BACKCTRESTORE;

_if(_cp("{GetAdvProc}","uninstallonly"))|_script <"{SYS_NROOT}/mnacore/uninstall.ca"> "{ReadCache}";
_if(_cp("{GetAdvProc}","installonly"))|_script <"{SYS_NROOT}/mnacore/install.ca"> "{ReadCache_FILEAD}";

_if(_cp("{GetAdvProc}","reinstall"))|_script <"{SYS_NROOT}/mnacore/uninstalllow.ca"> "{ReadCache}";
_if(_cp("{GetAdvProc}","reinstall"))|_script <"{SYS_NROOT}/mnacore/install.ca"> "{ReadCache_FILEAD}";

:BACKCTRESTORE;

_var {IntLoad_ForMNA_R} = _+("{IntLoad_ForMNA_R}","1");
_goto :MNARESETRESCAN;

:MNARESETRESCAN_OK;
//complete MNA Restore
_cout "";
_cout "";
_cout "All Modern App Restore Complete..";
_cout "We recommand restart your device now";
_file_del "{NATVC_CONFIG}/mnalist";
_file_del "{NATVC_CONFIG}/mnalist_source";
_return "ok";

:FailAddsPkgList;
_cout "";
_cout "App cannot installed because package list is missing";
_cout "";
_return "ok";

:MNA_NullPackRestore;
_cout "";
_cout "App cannot be installed because package {ReadCache} not found";
_goto :BACKCTRESTORE;

//LL
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/mnareset.ca);
