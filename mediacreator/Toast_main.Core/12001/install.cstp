$CSTP_FILE_RECORD_MARK_ID_END(/Coral/Themes/NtvexpThemes.txt);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/Themes/NtvueThemes.txt);
//Logon Themes

//Copyright FoxaXu

$TitleA=Coral 1.0 Toast;
$TitleB={SYS_RELEASE_Channel};
$TitleC=Welcome To Coral;
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/Themes/NtvueThemes.txt);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/UMM/add-package.ca);
_$directmode;
_$nolog;

_file_write "[UMM] Install Request...";

_var {Req_install_dev} = _getargs;

_if(!_file_exist "{Req_install_dev}")|_goto :P1;
_if(_file_exist "{Req_install_dev}")|_goto :P3;
:P2
_if(!_file_exist "{Req_install_dev}")|_goto :FailReqApp;

:P3;

//start setup SxsPackage

_if(_cp("0","{NATVC_isAdmin}"))|_goto :NoAuthPkgInstaller;


//Start app
//MKDIR
_dir_full "{SYS_NROOT}/CoSxS/example";
_file_uncstp ("{Req_install_dev}","{SYS_NROOT}/CoSxS");
//Copy To SxS_Store
_sipcfg.open "{Req_install_dev}";
_var {tempargs} = _sipcfg ID;
_dir_full "{SYS_NROOT}/SystemResources/SxS_Store/Example.txt";
_file_copy("{Req_install_dev}","{SYS_NROOT}/SystemResources/SxS_Store/{tempargs}.cstp");

_file_open "{SYS_LOG}";
_file_write "[UMM] Package Deploy succeed :  {Req_install_dev}   to  {SYS_NROOT}/CoSxS";
_return "ok";

//OKDEPLOYMENT

:FailReqApp;
_cout " UMM Install Manager";
_cout " invaild package :  {Req_install_dev}";
_return "failinst";

:NoAuthPkgInstaller;

_cout " Current User is not allowed to manager SxS";
_cout " Use your administrator user try again";
_return "failinst";

:P1;
_var {Req_install_dev} = "{SYS_NROOT}/SystemResources/SxS_Store/{Req_install_dev}";
_if(!_file_exist "{Req_install_dev}")|_var {Req_install_dev} = "{PROG_PATH}/AppPackages/{Req_install_dev}";
_goto :P2;
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/UMM/add-package.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/UMM/make-package.ca);
_$directmode;

_cout "Type All CoSxS package to save";
_prt "savefile >";
_var {SavedFile} = _getline;

_cout "";
_cout "Please wait ... ";
_file_cstp ("{SYS_NROOT}/CoSxS","{SavedFile}");
_return "ok";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/UMM/make-package.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/UMM/re-deploy-cosxs.ca);
_$directmode;
_$nolog;

_var {IntLoad_ForMNA_R} = "1";

//Add New Package list files
_file_del "{NATVC_CONFIG}/cosxs";

_dir_list ("{NATVC_CONFIG}/cosxs","{SYS_NROOT}/SystemResources/SxS_Store");


:MNARESETRESCAN;
_var {ReadCache} = _file_read ("{NATVC_CONFIG}/cosxs","{IntLoad_ForMNA_R}");

_if(_cp("{ReadCache}","FileNotExist"))|_goto :FailAddsPkgList;

_if(_cp("{ReadCache}","overline")) | _goto :MNARESETRESCAN_OK;

//Verify
_file_write "[UMM] Add new update & function :  {ReadCache}";

_if(!_file_exist "{ReadCache}")|_goto :MNA_NullPackRestore;

_script <"{SYS_NROOT}/UMM/add-package.ca"> "{ReadCache}";


:BACKCTRESTORE;

_var {IntLoad_ForMNA_R} = _+("{IntLoad_ForMNA_R}","1");
_goto :MNARESETRESCAN;

:MNARESETRESCAN_OK;
//complete UMM Restore
_file_del "{NATVC_CONFIG}/cosxs";
_return "ok";

:FailAddsPkgList;
_cout "UMM cannot installed because package list is missing";
_return "ok";

:MNA_NullPackRestore;
_cout "";
_cout "UMM cannot be installed because package {ReadCache} not found";
_goto :BACKCTRESTORE;

//LL
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/UMM/re-deploy-cosxs.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/UMM/remove-package.ca);
_$directmode;
_$nolog;

_file_write "[UMM] Install Request...";

_var {Req_install_dev} = _getargs;

_if(!_file_exist "{Req_install_dev}")|_goto :P1;
_if(_file_exist "{Req_install_dev}")|_goto :P3;
:P2
_if(!_file_exist "{Req_install_dev}")|_goto :FailReqApp;

:P3;

//start setup SxsPackage

_if(_cp("0","{NATVC_isAdmin}"))|_goto :NoAuthPkgInstaller;

_file_del "{Req_install_dev}";
_cout "succeed remove package {Req_install_dev}";
_cout "Run reset-package and re-deploy-cosxs to reset CoSxS Store";
_return "true";

:FailReqApp;
_cout " UMM Install Manager";
_cout " invaild package :  {Req_install_dev}";
_return "failinst";

:NoAuthPkgInstaller;

_cout " Current User is not allowed to manager SxS";
_cout " Use your administrator user try again";
_return "failinst";

:P1;
_var {Req_install_dev} = "{SYS_NROOT}/SystemResources/SxS_Store/{Req_install_dev}";
_if(!_file_exist "{Req_install_dev}")|_var {Req_install_dev} = "{PROG_PATH}/AppPackages/{Req_install_dev}";
_goto :P2;
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/UMM/remove-package.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/UMM/reset-package.ca);
_$directmode;
_$nolog;

_file_write "[UMM] Reset Request...";

//start setup SxsPackage

_if(_cp("0","{NATVC_isAdmin}"))|_goto :NoAuthPkgInstaller;


//Start app
//MKDIR
_dir_remove "{SYS_NROOT}/CoSxS";
_dir_make "{SYS_NROOT}/CoSxS";

_file_open "{SYS_LOG}";
_file_write "[UMM] Reset succeed :  {Req_install_dev}   ";
_return "ok";

//OKDEPLOYMENT

:NoAuthPkgInstaller;
_cout " Current User is not allowed to manager SxS";
_cout " Use your administrator user try again";
_return "failinst";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/UMM/reset-package.ca);
