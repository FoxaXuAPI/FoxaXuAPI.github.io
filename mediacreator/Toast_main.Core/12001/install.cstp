_ms_sleep "300";

_sipcfg.open "{NATVC_CONFIG_SETUP}";
_sipcfg ModernAppReady = "1";
_sipcfg.open "{SYS_NROOT}/config/DeploySettings";

_clear;
_cout "Software Protection Service is trying to verify your product!";
_ms_sleep "300";
_var {UserType} = _script <"{SYS_ROOT}/services.ca"> "sppsvc";
_file_write "[%time%][CoralDeploy] Sppsvc Status :  {UserType}";


_clear;
_var {update_title} = "Cleanup Install Source";
