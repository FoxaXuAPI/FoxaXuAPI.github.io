$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/confedit.ca);
_$directmode;
_$nolog;
//Config Editor Tool
//Args use "openedit"

_var {ToolsName} = "CONFEDIT";
_var {CONFEDIT_TEMP_SIGN} = "false";
_if(_cp(_getargs,"openedit"))|_goto :OpenEditor;
_if(_cp("{NATVC_isAdmin}","0"))|_goto :FAIL_DISALLOW;
_var {CONFEDIT_TEMP_SIGN} = "true";



//Natvc Config Editor
:BACKMAINCONSOLE;

_if(!_cp("{CONFEDIT_TEMP_SIGN}","true"))|_return "exitconsole";

_clear;

_cout "----------------------------------------------";
_cout "# Coral Config Editor";
_cout "----------------------------------------------";
_cout "  Coral Config Editor ";
_cout "     System Config Index:   ";
_cout "";

_dir_list ("{temp}/confedit","{NATVC_CONFIG}");
_file_replace "{temp}/confedit" ("{NATVC_CONFIG}/","  ");
_file_replace "{temp}/confedit" ("/{NATVC_CONFIG}/","  ");
_file_replace "{temp}/confedit" ("/{NATVC_CONFIG}","  ");

_textprint "{temp}/confedit";
_file_del "{temp}/confedit";
_cout "";
_cout "";
_cout " Select and Settings.  use exit to back ";
_cout " Mode (1 - edit/creat new reg .  2 - del reg)";
_cout " You can open any Config Files";
_cout "----------------------------------------------";


_prts "Open File >";
_var {regmode} = _getline;
_if(_cp("{regmode}",".exit"))|_return "ok";
_if(_cp("{regmode}","exit"))|_return "ok";
_if(_cp("{regmode}","about"))|_goto :About;
//Check Files

_var {RegOpenFile} = "{regmode}";
_if(_file_exist "{RegOpenFile}")|_goto :OpenEditor;

_var {RegOpenFile} = "{NATVC_DISK}/{regmode}";
_if(_file_exist "{RegOpenFile}")|_goto :OpenEditor;

_var {RegOpenFile} = "{SYS_NROOT}/config/{regmode}";
_if(_file_exist "{RegOpenFile}")|_goto :OpenEditor;

_var {RegOpenFile} = "{NATVC_USERPROFILE}/{regmode}";
_if(_file_exist "{RegOpenFile}")|_goto :OpenEditor;

_goto :BACKMAINCONSOLE;




:OpenEditor;
_if(!_file_exist "{RegOpenFile}")|_return "failopen";
_sipcfg.open "{RegOpenFile}";
_clear;
_cout "Config Edit   ({SYSNAME}.{SYS_KERNEL_VID})";
_cout "#--------------------------------------------------------#";
_cout "  Edit File :  {RegOpenFile}";
_cout " --------------------------------------------------------";
_textprint "{RegOpenFile}";
_cout "#--------------------------------------------------------#";

_prts "Set add/edit(1) or delete(2) . use .exit back>";
_var {useropt} = _getline;
_if(_cp("{useropt}",".exit"))|_goto :BACKMAINCONSOLE;
_if(_cp("{useropt}","exit"))|_goto :BACKMAINCONSOLE;
_if(_cp("{useropt}","1"))|_goto :EditMode;
_if(_cp("{useropt}","2"))|_goto :DelMode;
_goto :OpenEditor;

:EditMode;
_prts "select edit module(add / edit) > ";
_var {useroptE} = _getline;
_if(_cp("{useroptE}",".exit"))|_goto :OpenEditor;

_prts "type new info > ";
_var {useroptY} = _getline;
_if(_cp("{useroptY}",".exit"))|_goto :OpenEditor;

_sipcfg {useroptE} = "{useroptY}";
_goto :OpenEditor;





:DelMode;
_prts "select edit module(Remove) > ";
_var {useroptE} = _getline;
_if(_cp("{useroptE}",".exit"))|_goto :OpenEditor;

_sipcfg.remove {useroptE};
_goto :OpenEditor;





:About;
_clear;
_typefile "{NATVC_ABOUTS_TEXT}";
_pause;
_goto :BACKMAINCONSOLE;




//ERRPAGE
:FAIL_DISALLOW;
_clear;
_cout "NATVC CONFIG EDIT";
_cout "For system security reasons, current users cannot run User Settings";
_cout "User :  {NATVC_USERNAME} ({NATVC_WHOIS})  IA :  {NATVC_isAdmin}";
_cout "Press Enter ...";
_pause;
_return "user_noauth";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/confedit.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/confget.ca);
_$directmode;
_$nolog;
_$no_err_report;

//Coral Config Get
//Get File

_free {callback_temp};

_sipcfg.open "{NATVC_CONFIG_SETUP}";
_if(_cp(_sipcfg whitelist,"1"))|_goto :WL_Mode;


:Fallback_WL;

_if(!_file_exist "{CONFGET_FILE}") |_return "null";

_sipcfg.open "{CONFGET_FILE}";

_free {ConfGet_CALLBACK_PTR};

_var {ConfGet_CALLBACK_PTR} = _sipcfg {CONFGET_WORD};


_return "{ConfGet_CALLBACK_PTR}";


:WL_Mode;
_sipcfg.open "{NATVC_CONFIG_SETUP}";
_var {VAILD_RUN} = _sipcfg whitelist_file;

_if(!_file_exist "{VAILD_RUN}")|_goto :Fallback_WL;

_sipcfg.open "{VAILD_RUN}";
_if(!_cp(_sipcfg {CONFGET_WORD},"true"))|_return "false";
_return "true";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/confget.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/croskrnl.ca);
_$directmode;
_$no_err_report; //avoid load missing resources report error

_if(_cp("{SysLocker}","true"))|_return "Unloaded Kernel. Failed to fetch memory [SysLocker] ";

//CORAL SYSTEM KERNEL (BASE NATVC KERNEL)

_var {tempargs_ramdisk} = _getfile;
_if(_cp("{tempargs_ramdisk}","{RAMDISK}/Coral Kernel and System"))|_goto :SkipInitRAMDISK;
_file_copy("{tempargs_ramdisk}","{RAMDISK}/Coral Kernel and System");
_cover <"{RAMDISK}/Coral Kernel and System">;
_return "RAMDISK_ERROR_COPY";
:SkipInitRAMDISK;

//Test Hiber Mode
_if(_cp("{HiberMode}","1"))|_file_open "{SYS_LOG}";
_if(_cp("{HiberMode}","1"))|_typefile "{NATVC_BOOTUI}";
_if(_cp("{HiberMode}","1"))|_goto :LoadSystemMain;

//Load ENV

_var {SysLocker} = "true";

//KernelVerify
_if(!_file_exist "{NATVC_DISK}/{Boot_OSPATH}/System/Kernel/krnlvf.ca") |_goto :KernelVerifyFailed;
_if(!_script <"{NATVC_DISK}/{Boot_OSPATH}/System/Kernel/krnlvf.ca">)   |_goto :KernelVerifyFailed;



//Register.CA
_if(!_script <"{SYS_ROOT}/Kernel/registery.ca">)|_goto :SysBootFallbackConfig;
/////////////////////////////////// RCA

//Register.CA
_script <"{SYS_ROOT}/Kernel/tdldr.ca">;
/////////////////////////////////// RCA

//Load Boot Options on BOOTLOADER
_var {tempargs} = _script <"{SYS_ROOT}/Kernel/bootoptldr.ca">;
_if(_cp("{tempargs}","shutdown"))|_goto :SHUTDOWN_OK;
_if(_cp("{tempargs}","restart"))|_goto :RESTART_OK;

_if(!_file_exist "{BootLogFiles}")|_goto :SkipCopyBootLog;
_file_copy ("{BootLogFiles}","{SYS_LOG}");
:SkipCopyBootLog;

_file_open "{SYS_LOG}";

_file_write "@ NATVC is a simulation system. based on Calcium_Project(EXE) and BVM_Project(Script). Copyright FoxaXu 2024";

_if(_cp("{NoGUIBootOpt}","1"))| _cout "Checking System FMV";

// Check Hardware Complier
_if(!_=>("{CalciumL_FMV}","{NATVC_FMV_REQ}"))|_goto :CompilerWarning;
:BackToTryBoot;
_sipcfg.open "{NATVC_CONFIG_SETUP}";
_if(!_cp(_sipcfg FILECHECK,"true"))|_goto :GORECOVERY;

//Check last startup;
_if(_cp("{NoGUIBootOpt}","1"))| _cout "BOOTLOAD :   OSVCHECK.CA";
_script <"{SYS_ROOT}/Kernel/osvcheck.ca">


_if(_cp(_sipcfg shutdown_record,"0")) | _goto :BackToNormalBoot;

_if(_cp("{RE_ENV}","true"))|_goto :BackToNormalBoot;

_var {Shutdown_Data} = _sipcfg shutdown;
_if(_cp("{Shutdown_Data}","1")) | _goto :failbootRecovery;

_if(_cp("{NATVC_A_RE}","true")) | _goto :failbootRecovery;

_sipcfg shutdown = "1";

:BackToNormalBoot;

//Execute Memory Startup Clear
_if(_cp("{RE_ENV}","true"))|_goto :SkipEMSC;
_if(!_cp("{TaskStartupMemClear}","true"))|_goto :SkipEMSC;
_if(_cp("{NoGUIBootOpt}","1"))| _cout "BOOTLOAD :   StartupMemoryClear.ca";
_if(_file_exist "{NATVC_DISK}/{Boot_OSPATH}/SystemResources/SystemStartup/StartupMemoryClear.ca")|_script <"{NATVC_DISK}/{Boot_OSPATH}/SystemResources/SystemStartup/StartupMemoryClear.ca"> "KernelResetMemory";
_free {TaskStartupMemClear};
_goto :RESTART_OK;

//Complete
:SkipEMSC;

//Check Is Kernel Need Update
_if(!_cp(_sipcfg startup_execute,"noexec")) | _goto :UpdateKernel;
:backUpdateKernel;

_var {temp_record_time} = _getfulltime;
_sipcfg last_startup = "{temp_record_time}";

//Display

_file_write "@ [%time%][SYSTEM] System is Startup on %fulltime%";

//Load System
//OSLDR.CORAL.CA
_if(_cp("{NoGUIBootOpt}","1"))| _cout "BOOTLOAD :   osldr.ca";
_if(!_script<"{SYS_ROOT}/Kernel/osldr.ca">)|_goto :SysBootFallbackConfig;

//Check Bootloader is Trusted
//Config Boot Check Files

_free {BL_Verify_F};

_if(_cp("{BootMethod}","nbfload"))   | _var {BL_Verify_F} = "{SYS_NROOT}/nbf/bootmgr.nbf";
_if(_cp("{BootMethod}","boot"))      | _var {BL_Verify_F} = "{SYS_NROOT}/sysboot/bootmgr.ca";

_file_write "[%time%][Kernel][Boot] BL Verify : {BL_Verify_F}";
_file_write "[%time%][Kernel][Boot] BL Current :  {BVM_OSBOOT}";

_if(_cp(_sipcfg BL_TrustCheck,"false"))|_goto :SkipBLTrustCheck;

_if(!_file_cp("{BVM_OSBOOT}","{BL_Verify_F}"))|_goto :BLFail_Repair;

_file_write "[%time%][Kernel][Boot] Bootloader is trusted";
_file_write "[%time%][Kernel][Boot] BL File :  {BVM_OSBOOT}";
:SkipBLTrustCheck;

//Load HAL
_file_write "[%time%][Kernel][Boot] Loading HAL";
_if(_cp("{NoGUIBootOpt}","1"))| _cout "Loading HAL.CA to Kernel ...";
_if(!_file_exist "{SYS_ROOT}/hal.ca")|_return "{SYS_ROOT}/hal.ca";
_if(_cp("{NoGUIBootOpt}","1"))| _cout "BOOTLOAD :   hal.ca";
_if(!_script <"{SYS_ROOT}/hal.ca">)|_goto :LoadHALFailed;
_file_write "[%time%][Kernel][Boot] Load HAL OK";


//Load System Data
//OSDATA LDR CORAL.CA
_if(_cp("{NoGUIBootOpt}","1"))| _cout "BOOTLOAD :   osdatldr.ca";
_script<"{SYS_ROOT}/Kernel/osdatldr.ca">;

_var {NATVC_ABOUTS_TEXT} = _sipcfg NATVC_ABOUTS_TEXT;

_var {NATVC_CRASH_TEXT} = _sipcfg NATVC_CRASH_TEXT;
_var {NATVC_CRASH_TEXT} = "{NATVC_DISK}/{NATVC_CRASH_TEXT}";

_var {SystemTemp} = "{SYS_NROOT}/Temp";
_if(!_dir_exist "{SystemTemp}")|_dir_make "{SystemTemp}";

_if(_cp("{NoGUIBootOpt}","1"))|_goto :SkipLoadUIBoot2;
_if(_cp("{boot_rsmode}","true"))|_goto :SkipLoadUIBoot2;
_script <"{SYS_ROOT}/ntvani.ca">;
:SkipLoadUIBoot2;

//END
//Load System Driver
_if(_cp("{EnableSystemUserProtection}","true"))|_file_write "[%time%][SECURITY] System User Protection is Enabled";
_if(_cp("{EnableSystemUserProtection}","true"))|_script <"{SYS_NROOT}/SystemManager/initSystemUser.ca">;
_if(_cp("{boot_rsmode}","true"))|_goto :SkipLoadSystemDRV;
_if(_cp("{NoGUIBootOpt}","1"))| _cout "Loading System Drivers...";
_if(!_file_exist "{SYS_ROOT}/drvload.ca")|_goto :FailedCrashDrvMissing;

_sipcfg.open "{NATVC_CONFIG_USERS}";
_if(!_cp(_sipcfg Local_Driver_Security_User,"Coral/SystemManager/Local_Driver_Security_User"))|_goto :ENFORCE_STARTUP_SUPT;

_var {NATVC_isAdmin} = "2";
_var {K_SERVICE_CALLBACK} = _script <"{NATVC_USERSVC}"> "Local_Driver_Security_User";
_var {drvload_callback} = _script <"{SYS_ROOT}/services.ca"> "sddload";

_file_write "[%time%][Kernel] Driverloader report status :   {drvload_callback}";

_if(_cp("{drvload_callback}","shutdown"))|_file_write "[%time%][Kernel] Shutdown Require";
_if(_cp("{drvload_callback}","shutdown"))|_goto :SHUTDOWN_OK;
_if(_cp("{drvload_callback}","restart"))|_file_write "[%time%][Kernel] Reboot Require";
_if(_cp("{drvload_callback}","restart"))|_goto :RESTART_OK;
_if(_cp("{drvload_callback}","ok"))|_goto :DriverLoadSucceed;
_var {K_SERVICE_CALLBACK} = "FailedCrashDrvLoader";
_script <"{SYS_ROOT}/Kernel/krnldmp.ca">;
_var {SysLocker} = "false";
_pause;
_return "{NATVC_CRASH_EXECUTE}";

:DriverLoadSucceed;
:SkipLoadSystemDRV;
//Check SysImage

_if(_cp("{NoGUIBootOpt}","1"))| _cout "Checking System Image...";

_if(!_dir_exist "{NATVC_DISK}/{Boot_OSPATH}/RepairData")|_var {CALLSYSFIX} = _script<"{NATVC_DISK}/{Boot_OSPATH}/System/sysfix.ca"> "new";

_if(_cp("{CALLSYSFIX}","restart"))|_goto :RESTART_OK;

_if(_cp("{NoGUIBootOpt}","1"))| _cout "initialize User Interface ...";

_if(_cp("{NoGUIBootOpt}","1"))| _ms_sleep 1500;

_clear;

//Restore Default CS
_var {NATVC_CRASH_CODE} = "UNKNOWN_ERROR_KERNEL_BREAK";
_var {NATVC_CRASH_MESSAGE} = "Kernel Suspended and Stop Running(might for debug reason)";

_file_write "[%time%][Kernel][Boot] The Kernel Interrupt Protection Service is loaded";

_var {IsAutoLogin} = true;

//Complete
//Load SYSTEM USER
:LoadSystemMain;
//_if(_cp("{HiberMode}","1"))|_clear;
_if(_cp("{HiberMode}","1"))|_file_write "[%time%][Kernel][Boot] System Wake up from hiberfile";
_if(_cp("{HiberMode}","1"))|_file_write "@ [%time%][SYSTEM] System is Wake up on %fulltime%";

_var {HiberMode} = "0";

_if(!_file_exist "{NATVC_USERSVC}") | _return "{NATVC_USERSVC}";
//_var {PRE_AUTOENTRY_PASSWORD} = "@nopswd";

_var {UserSVCBUFFER} = "KernelModeDetect";

_if(_cp("{Shutdown_Data}","1")) |_dir_remove "{SYS_NROOT}/SECURITY";


_var {NATVC_isAdmin} = "2";
_var {K_SERVICE_CALLBACK} = _script <"{NATVC_USERSVC}"> "SYSTEM";


_if(_cp("{K_SERVICE_CALLBACK}","user_logoff")) | _goto :SHUTDOWN_OK;
_if(_cp("{K_SERVICE_CALLBACK}","user_shutdown")) | _goto :SHUTDOWN_OK;
_if(_cp("{K_SERVICE_CALLBACK}","user_restart")) | _goto :RESTART_OK;
_sipcfg.open "{SYS_NROOT}/SECURITY/SYSTEM.nuslc";
_sipcfg KernelProtect = "true";


_if(!_cp("{K_SERVICE_CALLBACK}","reload_SYSTEM"))|_goto :FAILLOGIN_SYSTEM;

_var {K_SERVICE_CALLBACK} = _script <"{SYS_ROOT}/ntvlogon.ca"> "Kernel_int_load_system";

_file_write "[%time%][Kernel] NUES Service is Closed.  Argument:  {K_SERVICE_CALLBACK}";

_if(_cp("{K_SERVICE_CALLBACK}","user_logoff")) | _goto :SHUTDOWN_OK;
_if(_cp("{K_SERVICE_CALLBACK}","user_shutdown")) | _goto :SHUTDOWN_OK;
_if(_cp("{K_SERVICE_CALLBACK}","user_restart")) | _goto :RESTART_OK;

//If nues service crash

//System API
_if(_cp("{K_SERVICE_CALLBACK}","$shutdown")) | _goto :SHUTDOWN_OK;
_if(_cp("{K_SERVICE_CALLBACK}","$reboot")) | _goto :RESTART_OK;
_if(_cp("{K_SERVICE_CALLBACK}","$hiber")) | _return "$shutdown";

_if(_cp("{K_SERVICE_CALLBACK}","shutdown")) | _goto :SHUTDOWN_OK;
_if(_cp("{K_SERVICE_CALLBACK}","restart")) | _goto :RESTART_OK;
_if(_cp("{K_SERVICE_CALLBACK}","logoff")) | _goto :SHUTDOWN_OK;

_file_write "[%time%][Kernel][Error] Unexpected error on Callback :  {K_SERVICE_CALLBACK}";

_file_write "[%time%][Kernel][Error] An attempt is being made to analyze the issue and generate a report";

_script<"{SYS_ROOT}/Kernel/krnldmp.ca">;

:SkipKRP;

_if(!_cp("{NATVC_CRASH_AUTOREBOOT}","1"))|_cout "                 Press enter to Continue";
_if(!_cp("{NATVC_CRASH_AUTOREBOOT}","1"))|_pause;
_if(_cp("{NATVC_CRASH_AUTOREBOOT}","1"))|_cout "                 System will automatic reboot in {NATVC_CRASH_AUTOREBOOT_TIME} seconds";
_if(_cp("{NATVC_CRASH_AUTOREBOOT}","1"))|_sleep "{NATVC_CRASH_AUTOREBOOT_TIME}";

_file_write "[%time%][Kernel] Crash Report is saved on :  {SYS_NROOT}/MiniRep/CrashReport-{CurrentDate}-{LOG_REPSTR}.txt";
_file_write "[%time%][Kernel] try to contact develop and send them this file";
_file_write "[%time%][Kernel] System Closed(unexpected)";
_var {SysLocker} = "false";
_return "{NATVC_CRASH_EXECUTE}";
_exit;


//Error Code
:NUES_EXIT;
_clear;
_file_write "[%time%][Kernel][WARNING] UES Stopped with Exception!";
_cout "Failed to initialize the User Experience Service (UES).";
_cout "Press Enter to restart UES Service";
_pause;
_dir_remove "{SYS_NROOT}/SECURITY";
_goto :LoadSystemMain;

//Load Recovery
:failbootRecovery;
_var {NATVC_A_RE} = "false";
_var {SystemStartupNotification} = "Please select boot option";

_if(_cp("{Shutdown_Data}","0")) | _goto :SkipProcessUnexp;

_file_write "[%time%][NATVC Boot Loader][Error] last shutdown is unexpected";
_var {SystemStartupNotification} = "System last shutdown is unexpected.";

:SkipProcessUnexp;
_if(_cp("{RE_ENV}","true")) | _goto :DONOTTYPEADVUIONRE;
_file_write "[%time%][NATVC Boot Loader] Load Advanced Boot Option .. ";
_clear;
_typefile "{NATVC_Fail_Startup}";
_prt "Type here. default 1 >";
_var {boot_set} = _getline;
_clear;
_if( _cp ("{boot_set}" , "s") )| _goto :NBR_REPAIR;
_if( _cp ("{boot_set}" , "2") )| _goto :NBR_RS;
_if( _cp ("{boot_set}" , "3") )| _goto :NBR_RBS;
_if( _cp ("{boot_set}" , "4") )| _goto :SHUTDOWN_OK;
_if( _cp ("{boot_set}" , "5") )| _goto :GORECOVERY;
_file_write "[%time%][Kernel] Startup Recovery :  Normal Boot";
_clear;
_if(_cp("{NoGUIBootOpt}","1"))| _goto :SkipLoadUIBoot3;
:DONOTTYPEADVUIONRE;
_typefile "{NATVC_BOOTUI}";
:SkipLoadUIBoot3;

_goto :BackToNormalBoot;

//Other
:NBR_REPAIR;
_var {checksysfix} = "true";
_goto :RESTART_OK;


:NBR_RS;
_file_write "[%time%][Kernel] Advanced Boot Option :  Load Safe mode (rootshell)";
_var {boot_rsmode} = "true";
_clear;

_if(_cp("{NoGUIBootOpt}","1"))| _goto :SkipLoadUIBoot4;
_typefile "{NATVC_BOOTUI}";
:SkipLoadUIBoot4;

_goto :BackToNormalBoot;


:NBR_RBS;
_file_write "[%time%][Kernel] Advanced Boot Option :  Reboot and select boot device";
_var bvm_bm = "true";
_goto :RESTART_OK;

//Set Shutdown Complete
:SHUTDOWN_OK;
_free {RE_ENV};
_free {CALLSYSFIX};
_file_write "[%time%][Kernel] System Closed (Normal)";

_var {temp_record_time} = _getfulltime;

_file_write "@ [%time%][SYSTEM] System Closed on :   {temp_record_time}";


_if(!_file_exist "{NATVC_DISK}/hiberfile.txt") | _var {Next_startup_fast_boot} = "-1";

_if(_cp("{Next_startup_fast_boot}","-1"))|_sipcfg.open "{NATVC_CONFIG_SETUP}";
_if(_cp("{Next_startup_fast_boot}","-1"))|_sipcfg shutdown = "0";
_if(_cp("{Next_startup_fast_boot}","-1"))|_sipcfg last_shutdown = "{temp_record_time}";

_if(_cp("{Next_startup_fast_boot}","1"))|_sipcfg.open "script/hiberdata";
_if(_cp("{Next_startup_fast_boot}","1"))|_sipcfg hiberfile = "{NATVC_DISK}/hiberfile.txt";
_if(_cp("{Next_startup_fast_boot}","1"))|_file_write "[%time%][Kernel] Next Startup will use fast boot";

_if(_cp("{Next_startup_fast_boot}","-1"))|_file_del "script/hiberdata";
_if(_cp("{Next_startup_fast_boot}","-1"))|_file_del "{NATVC_DISK}/hiberfile.txt";
_if(_cp("{Next_startup_fast_boot}","-1"))|_file_write "[%time%][Kernel] Fast boot is turn off on next startup";

_if(_cp("{Next_startup_fast_boot}","-1"))|_dir_remove "{SYS_NROOT}/SECURITY";

_var {SysLocker} = "false";
_return "$shutdown";

:RESTART_OK;
_free {RE_ENV};
_free {CALLSYSFIX};
_file_write "[%time%][Kernel] System Closed (Normal)";
_sipcfg.open "{NATVC_CONFIG_SETUP}";
_sipcfg shutdown = "0";
_var {temp_record_time} = _getfulltime;
_sipcfg last_shutdown = "{temp_record_time}";
_file_write "@ [%time%][SYSTEM] System Closed on :   {temp_record_time}";


_file_del "script/hiberdata";
_file_del "{NATVC_DISK}/hiberfile.txt";

_dir_remove "{SYS_NROOT}/SECURITY";

//CHECK PRE RESULT
_if(!_cp("1","{RestartExecuteMemReset}"))|_goto :SKIPDETECTMEMRESET;
_if(_cp("1","{IsSystemRestartToRE}"))|_goto :SKIPDETECTMEMRESET;

//START
_if(_file_exist "{SYS_ROOT}/memreset.ca")|_script <"{SYS_ROOT}/memreset.ca"> "KernelResetMemory";

:SKIPDETECTMEMRESET;
_free {RestartExecuteMemReset};
_free {IsSystemRestartToRE};

_var {SysLocker} = "false";
_return "$reboot";




:UpdateKernel;
_clear;
_file_write "[%time%][Kernel][Update] Kernel Need Update";
_var {ReCreateImage} = "true";
//Get Update Execute File
_sipcfg.open "{NATVC_CONFIG_SETUP}";
_var {update_execute} = _sipcfg startup_execute;
_var {update_title} = _sipcfg startup_exe_title;

//restore default
_sipcfg startup_exe_title = "Prepare Update ";
_sipcfg startup_execute = "noexec";

_file_write "[%time%][Kernel][Update] Execute File :  {update_execute}";
_file_write "[%time%][Kernel][Update] Check File Exist if not back restart";

_if(!_file_exist "{update_execute}")|_goto :backUpdateKernel;
_file_write "[%time%][Kernel][Update] Start Update File :  {update_execute}";


_file_write "[%time%][Kernel][Update] Title :  {update_title}";

_clear;
_typefile "{SYS_NROOT}/res/natvc-bootupdate.txt";

_file_write "[%time%][Kernel][Update] Starting Update";

_var {update_callback} = _script<"{update_execute}"> "kernel";

_script<"{NATVC_DISK}/{Boot_OSPATH}/System/sysfix.ca"> "remove";

_file_write "[%time%][Kernel][Update] Update End";
_file_write "[%time%][Kernel][Update] Status :  {update_callback}";
//If Need Restart
_if(_cp("{update_callback}","restart"))|_goto :RESTART_OK;
//Back Restart
_goto :backUpdateKernel;



//ToWARNING
:CompilerWarning;
_file_write "[%time%][NATVC Boot Loader][Error] Bootloader Report a problem :  Hardware not Complier & Warning";
_file_write "[%time%][NATVC Boot Loader][Error] Update your Platform {CalciumL_FMV} to {NATVC_FMV_REQ} or Later";
_clear;
_typefile "{NATVC_Compiler_Warning}";
_prt "Type here. default 2 >";
_var {boot_set} = _getline;
_clear;
_if( _cp ("{boot_set}" , "1") )|_goto :BackToTryBoot;
_file_write "[%time%][Kernel] Startup Recovery :  Shutdown";
_goto :SHUTDOWN_OK;


:BLFail_Repair;
_file_write "[%time%][Kernel][Boot][Error] Boot loader is not trusted try repair";

_var {update_title} = "System is update bootloader";

_clear;

_typefile "{SYS_NROOT}/res/natvc-bootupdate.txt";

_sleep 2;

_file_copy("{BL_Verify_F}","{BVM_OSBOOT}");

_goto :RESTART_OK;


:GORECOVERY;
_var {NTV_AutoRepair} = "true";

_cout "Recovery";

_ms_sleep 300;

_sipcfg.open "{NATVC_CONFIG_SETUP}";
_if (_cp(_sipcfg SystemRE_Status,"false"))|_goto :RESTART_OK;

_script <"{NATVC_DISK}/{Boot_OSPATH}/System/ntvrebl.ca">;

_goto :RESTART_OK;



:SysBootFallbackConfig;
_clear;

_file_write "[%time%][Kernel][Boot][ERROR] Some system config files are abnormal";
_file_write "[%time%][Kernel][Boot][ERROR] System need recovery";
_file_write "[%time%][Kernel][Boot][ERROR] Startup failed ..";

_return "CRITICAL_CONFIG_FILE_MISSING";


:LoadHALFailed;
_file_write "[%time%][Kernel][Boot][ERROR] Load HAL failed ..";
_return "Load HAL failed";

:ENFORCE_STARTUP_SUPT;
_file_write "[%time%][Kernel][Boot]Enforce Load System User Protection Service.";
_file_write "[%time%][Kernel][Boot]System need restart to continue.";
_file_write "[%time%][SECURITY] System User Protection Loaded";
_script <"{SYS_NROOT}/SystemManager/initSystemUser.ca">;
_goto :RESTART_OK;


:KernelVerifyFailed;
_file_write "[%time%][Kernel][Boot][ERROR] Kernel Verify Failed";
_return "Kernel_Verify_Failed";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/croskrnl.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/del.ca);
_$directmode;
_$nolog;

//File Delete
//Check args

_if(_cp("{NATVC_isAdmin}","0"))|_goto :FAIL_DISALLOW;

_var {file_delete_args} = _getargs;

_if(_file_exist "{rs_pathexec}/{file_delete_args}")|_goto :DELRSP;

_if(!_file_exist "{file_delete_args}")|_goto :userselect;

_cout "Delete file :  {file_delete_args}";
_file_del "{file_delete_args}";

_if(_file_exist "{file_delete_args}")|_goto :DeleteFail;
_return "delok";


:userselect;
_cout "Type File name";
_prts "file >";
_var {file_delete_args} = _getline;
_if(_file_exist "{rs_pathexec}/{file_delete_args}")|_goto :DELRSP;

_cout "Delete file :  {file_delete_args}";
_file_del "{file_delete_args}";

_if(_file_exist "{file_delete_args}")|_goto :DeleteFail;
_return "delok";

:DeleteFail;
_cout "Could not delete this file :  {file_delete_args}";
_cout "Access Is Denied";
_return "delfail";

:DELRSP;
_var {file_delete_args} = "{rs_pathexec}/{file_delete_args}";

_cout "Delete file :  {file_delete_args}";
_file_del "{file_delete_args}";

_if(_file_exist "{file_delete_args}")|_var :DeleteFail;
_return "delok";


//ERRPAGE
:FAIL_DISALLOW;
_clear;
_cout "FILE DELETE";
_cout "For system security reasons, current users cannot run User Settings";
_cout "User :  {NATVC_USERNAME} ({NATVC_WHOIS})  IA :  {NATVC_isAdmin}";
_cout "Press Enter ...";
_pause;
_return "user_noauth";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/del.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/diskmgr.ca);
_$directmode;

_clear;


_if(_cp("{NATVC_isAdmin}","0"))|_goto :FAIL_DISALLOW;

//MAKE DISK
:ReloadDM;

_free {SelectVolumeMode};
_var {AUserType} = _getargs;
_if(_cp("{AUserType}","$selectvolume"))|_var {SelectVolumeMode} = "true";

_if(_cp("{netvdisk.api_disk_address}",'{netvdisk.api_disk_address}'))|_goto :CannotFoundINputIO;
_if(!_dir_exist "{netvdisk.api_disk_address}")|_goto :CreateNewDiskTarget;
_clear;
//Load Main
:RELOADCONSOLE;

_file_del "{temp}/Explorer_cacheList.txt";
_var {EXPLORER_WORK_DIR} = "{netvdisk.api_disk_address}";
_clear;
_if(_cp("{SelectVolumeMode}","true"))|_cout "## Please Select a Volume";
_cout "#---- DISK MANAGER -------------------------------------------";
_cout "| VDISK Address :   {EXPLORER_WORK_DIR}";
_cout "#-------------------------------------------------------------";
_file_list ("{temp}/Explorer_cacheList.txt","{EXPLORER_WORK_DIR}");
_file_replace "{temp}/Explorer_cacheList.txt" ("{EXPLORER_WORK_DIR}/","");
_if(_file_exist "{temp}/Explorer_cacheList.txt")|_textprint "{temp}/Explorer_cacheList.txt";
_if(!_file_exist "{temp}/Explorer_cacheList.txt")|_cout "        No Volume. type 'new' to create volume";
_cout "---------------------------------------------------------------";
//MANAGER CONSOLE
_cout "Command :  'new' 'exit' 'clean'  ";
_prt "Select a Volume or type command >";
_var {UserType} = _getline;
//PROCESS
_if(_cp("{UserType}","new"))|_goto :NewPartition;
_if(_cp("{UserType}","exit"))|_return "exit";
_if(_cp("{UserType}","clean"))|_goto :ReCleanDiskManager;

_if(_dir_exist "{netvdisk.api_disk_address}/{UserType}")|_goto :ManageApi;
_cout "Unknown Command or invaild volume";
_pause;
_goto :RELOADCONSOLE;

:NewPartition;
_clear;
_cout "Type volume name you want created";
_var {UserType} = _getline;
_if(_dir_exist "{netvdisk.api_disk_address}/{UserType}")|_cout "The Volume is already exist";
_if(_dir_exist "{netvdisk.api_disk_address}/{UserType}")|_pause;
_if(_dir_exist "{netvdisk.api_disk_address}/{UserType}")|_goto :RELOADCONSOLE;
_dir_make "{netvdisk.api_disk_address}/{UserType}";
_if(!_dir_exist "{netvdisk.api_disk_address}/{UserType}")|_cout "Volume Create failed. might you don`t have Permission to control vdisk";
_if(!_dir_exist "{netvdisk.api_disk_address}/{UserType}")|_pause;
_goto :RELOADCONSOLE;

:ReCleanDiskManager;
_cout "Clean VDISK:  {netvdisk.api_disk_address} ? (y)";
_var {UserType} = _getline;
_if(_cp("{UserType}","y"))|_goto :ApplyResetVdisk;
_goto :RELOADCONSOLE;


:CreateNewDiskTarget;
_clear;
_cout "Local vdisk not be created. Do you want create a new disk? (y)";
_var {UserType} = _getline;
_if(_cp("{UserType}","y"))|_goto :NewDiskCreated;
_return "usercancel";

_dir_make "{netvdisk.api_disk_address}";
_goto :ReloadDM;

:ApplyResetVdisk;
//RESET DRIVERS
_if(_found("{NATVC_DISK}","{netvdisk.api_disk_address}"))|_goto :AccessDeniedOSPART;
_cout "Are you sure to reset vdisk? you will lost all data! (y)";
_var {UserType} = _getline;
_if(!_cp("{UserType}","y"))|_goto :RELOADCONSOLE;
_dir_remove "{netvdisk.api_disk_address}";
_dir_make "{netvdisk.api_disk_address}";
_goto :RELOADCONSOLE;

:AccessDeniedOSPART;
_clear;
_cout "Cannot Reset/Clean vdisk {netvdisk.api_disk_address}";
_cout "Current OS is running on {NATVC_DISK}.";
_pause;
_goto :RELOADCONSOLE;

:CannotFoundINputIO;
_clear;
_cout "Load netvdisk failed. is this driver is loaded?";
_cout "Disk manager failed start";
_pause;
_return "driver_missing:netvdisk";

:NewDiskCreated;
_dir_make "{netvdisk.api_disk_address}";
_goto :RELOADCONSOLE;


:ManageApi;
_clear;
_cout "Manage This Volume";
_cout "Address :  {netvdisk.api_disk_address}/{UserType}";
_cout "What do you want to do";
_cout "Command :  'remove'  'clean'  'backup'  'restore'  'exit' ";
_if(_cp("{SelectVolumeMode}","true"))|_cout "Type 'apply' to select this volume ";
_prt "Type >";
_var {Menu_Type} = _getline;
_if(_cp("{Menu_Type}","remove"))|_goto :removeVolume;
_if(_cp("{Menu_Type}","clean"))|_goto :cleanVolume;
_if(_cp("{Menu_Type}","backup"))|_goto :backupVolume;
_if(_cp("{Menu_Type}","restore"))|_goto :restoreVolume;
_if(_cp("{Menu_Type}","exit"))|_goto :RELOADCONSOLE;
_if(_cp("{Menu_Type}","apply"))|_return "{netvdisk.api_disk_address}/{UserType}";
_goto :ManageApi;

:removeVolume;
_if(_cp("{netvdisk.api_disk_address}/{UserType}","{NATVC_DISK}"))|_goto :AccessDeniedOSPART;
_dir_remove "{netvdisk.api_disk_address}/{UserType}";
_if(!_dir_exist "{netvdisk.api_disk_address}/{UserType}")|_goto :RELOADCONSOLE;
_cout "Remove Failed.";
_pause;
_goto :RELOADCONSOLE;

:cleanVolume;
_if(_cp("{netvdisk.api_disk_address}/{UserType}","{NATVC_DISK}"))|_goto :AccessDeniedOSPART;
_dir_remove "{netvdisk.api_disk_address}/{UserType}";
_if(!_dir_exist "{netvdisk.api_disk_address}/{UserType}")|_goto :cleanVolume2;
_cout "Remove Failed.";
_pause;
_goto :RELOADCONSOLE;

:cleanVolume2;
_dir_make "{netvdisk.api_disk_address}/{UserType}";
_cout "complete";
_pause;
_goto :RELOADCONSOLE;

:backupVolume;
_if(!_file_exist "{SYS_ROOT}/explorer.ca")|_goto :SkipFolderChoose;
_var {initFolder} = _script <"{SYS_ROOT}/explorer.ca"> "$choosefolder";
_if(!_dir_exist "{initFolder}")|_goto :SkipFolderChoose;
_goto :SetFileName;

:SkipFolderChoose;
_clear;
_cout "File Explorer is unavailable! cannot started. please type directory on console";
_prt "PATH>";
_var {initFolder} = _getline;

:SetFileName;
_prt "Type Save File>";
_var {Menu_Type} = _getline;
_var {Menu_Type} = "{initFolder}/{Menu_Type}";
_free {initFolder};
_file_cstp ("{netvdisk.api_disk_address}/{UserType}","{Menu_Type}");
_goto :RELOADCONSOLE;

:restoreVolume;
_var {Menu_Type} = _script <"{SYS_ROOT}/explorer.ca"> "$choosefile";
_if(!_file_exist "{Menu_Type}")|_goto :Failed_LoadFileNotExist;
_file_uncstp ("{Menu_Type}","{netvdisk.api_disk_address}/{UserType}");
_goto :RELOADCONSOLE;


:Failed_LoadFileNotExist;
_cout "File Not Exist";
_pause;
_goto :RELOADCONSOLE;


:FAIL_DISALLOW;
_cout "Up your auth to open this tool";
_pause;
_return "noauth";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/diskmgr.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/drvload.ca);
_$directmode;

//System Driver Loader
_var {drv_temp} = _getargs;

_if(_cp("{drv_temp}","HotDrvLoad"))|_goto :HotDrvloader;
_if(!_cp("{drv_temp}","Kernel_Load_Driver"))|_return "failuserauth";

_file_write "[%time%][DriverLoad] Start loading Coral Driver";

//List All Driver
_if(_file_exist "{SystemTemp}/drvlist.txt")|_file_del "{SystemTemp}/drvlist.txt";
_dir_list ("{SystemTemp}/drvlist.txt","{SYS_NROOT}/drivers");

//LIST ALL FILES
//FilePrint
_var {_DRVLoad_ReadINT} = "1";

:BackReload;
_var {DriverFile} = _file_read ("{SystemTemp}/drvlist.txt","{_DRVLoad_ReadINT}");
_if(_cp("{DriverFile}","overline"))|_return "ok";
_if(_cp("{DriverFile}","FileNotExist"))|_return "ok";
_file_write "[%time%][DriverLoad] Loading {DriverFile} ...";
_if(_cp("{NoGUIBootOpt}","1"))| _cout "BOOTLOAD DRIVERS :   {DriverFile}";

//LoadDRV
_var {DriverLoadResult} = _script <"{DriverFile}"> "load_driver";
_file_write "[%time%][DriverLoad] Complete load driver. Result Code: {DriverLoadResult}";

_if(_cp("{DriverLoadResult}","shutdown"))|_return "shutdown";
_if(_cp("{DriverLoadResult}","restart"))|_return "restart";
_if(!_cp("{DriverLoadResult}","drv_load_ok"))|_goto :FailedDRVLoad;
_var {_DRVLoad_ReadINT} = _+("{_DRVLoad_ReadINT}","1");
_goto :BackReload;



:FailedDRVLoad;
_return "DRV_ERROR: {DriverLoadResult}";


:HotDrvloader;

_if(!_file_exist "{DriverFile}")|_goto :NoFileFound;

_file_write "[%time%][DriverLoad][Hot] Loading {DriverFile} ...";

//LoadDRV
_var {DriverLoadResult} = _script <"{DriverFile}"> "hot_load";
_file_write "[%time%][DriverLoad][Hot] Complete load driver. Result Code: {DriverLoadResult}";

_if(!_cp("{DriverLoadResult}","drv_load_ok"))|_goto :FailedDRVLoad;
_return "true";

:NoFileFound;
_return "Driver Not Found .  File :  {DriverFile}";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/drvload.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/filecstp.ca);
//Coral File Cstp Tools
//Use _file_pack /  _file_unpack / _file_exist / _file_del  Exist API 
//Extract or PackFile
//Use NEW FORMAT

_$directmode;
_$nolog;

_if(_cp("{NATVC_isAdmin}","0"))|_goto :FAIL_DISALLOW;

_var {ToolsName} = "FileCstp";

:MainFileExplorer;
_clear;
_cout "File Cstp Tools ({SYSNAME}.{SYS_KERNEL_VID})";
_cout "----File Cstp and Extract tools--------------";
_cout "";
_cout "    1. Extract Mode";
_cout "    2. Pack Files";
_cout "";
_cout " Use New Cstp Format.";
_cout " Copyright foxaxu 2024";
_cout "---------------------------------------------";
_cout "select mode . (use .exit cancel)" 
_prts "$FileCstp >";
_var {UserExplorerConsole} = _getline;

_if(_cp("{UserExplorerConsole}","1"))|_goto :ExtractMode;
_if(_cp("{UserExplorerConsole}","2"))|_goto :PackFileMode;
_if(_cp("{UserExplorerConsole}",".exit"))|_return "ok";
_if(_cp("{UserExplorerConsole}","exit"))|_return "ok";
_goto :MainFileExplorer;



:ExtractMode;
_cout "Extract File.   Select File (use .exit cancel)";
_prts "$FilePack >";
_var {packfile} = _getline;
_if(_cp("{packfile}",".exit")) |_goto :MainFileExplorer;
_if(!_file_exist "{packfile}")  |_goto :ExtractMode;

_prts "$Extract Directory >";
_var {extractdir} = _getline;
_if(_cp("{extractdir}",".exit")) |_goto :MainFileExplorer;

_dir_remove "{extractdir}";
_file_uncstp ("{packfile}","{extractdir}");

_cout "Complete";
_pause;
_goto :MainFileExplorer;




:PackFileMode;
_cout "Pack File.   Select Dir";
_prts "$Dir >";
_var {extractdir} = _getline;
_if(_cp("{extractdir}",".exit")) |_goto :MainFileExplorer;

_if(!_dir_exist "{extractdir}")   |_goto :PackFileMode;

_prts "$Pack File Name >";
_var {packfile} = _getline;
_if(_cp("{packfile}",".exit")) |_goto :MainFileExplorer;

_dir_remove "{packfile}";
_file_cstp ("{extractdir}","{packfile}");

_cout "Complete";
_pause;
_goto :MainFileExplorer;



//ERRPAGE
:FAIL_DISALLOW;
_clear;
_cout " FILE CSTP";
_cout "For system security reasons, current users cannot run User Settings";
_cout "User :  {NATVC_USERNAME} ({NATVC_WHOIS})  IA :  {NATVC_isAdmin}";
_cout "Press Enter ...";
_pause;
_return "user_noauth";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/filecstp.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/hal.ca);
_$directmode;
//HAL COM PORT

//RequireCalcium SMA Enable
_if(!_sma "test")|_goto :FailLoadHAL;

_var {hal_api.SystemBase} = _sma "getsys";
_var {hal_api.common} = "Coral";

_return "true";
    


:FailLoadHAL;
_clear;
_cout "HAL Load failed";
_prt "File :  ";
_prt _getfile;
_cout "Please Enable SMA command on calcium settings.";
_pause;
_return "false";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/hal.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/hdrv.ca);
_$directmode;
_cout "Hot Driver Loaded";
_var {DriverFile} = _getargs;

_if(!_file_exist "{SYS_NROOT}/SECURITY/Local_Driver_Security_User.nuslc")|_goto :FailUserStatus;

_var {UserTypeA} = _script <"{SYS_ROOT}/services.ca"> "hotdrvload";

_cout "Driver load complete. result :  {UserTypeA}";
_return "{UserTypeA}";


:FailUserStatus;
_cout "Cannot loaded drivers!";
_cout "The system is running on safemode?. or last shutdown is unexpected?.";
_cout "Because of the reasons above, the system is running in compatibility mode,";
_cout "which caused some kernel items to be reset and made it impossible to hot-load drivers.";
_cout "Restart your device and try load again";
_return "false";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/hdrv.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/Kernel/bootoptldr.ca);
_$directmode;

_if(_cp("{SkipReloadBootOpts}","true"))|_goto :SkipReloadBootOpts;
_sipcfg.open "{BootVolume}/nbf/{BootDefaultOption}";

_var {BootOptions} = _sipcfg BootOptions;
:SkipReloadBootOpts;
_free {SkipReloadBootOpts};


_if(_found("{BootOptions}","safemode"))|_var {boot_rsmode} = "true";
_if(_found("{BootOptions}","advancemenu"))|_var {NATVC_A_RE} = "true";
_if(_found("{BootOptions}","debugmode"))|_var {EnableNatvcDebugReport} = "true";


_return "ok";

$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/Kernel/bootoptldr.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/Kernel/krnldmp.ca);
_$directmode;

//Exception
_if(_cp("{K_SERVICE_CALLBACK}","failsys")) | _goto :FAILSYSMODE;
_if(_cp("{K_SERVICE_CALLBACK}","fail_localsvc")) | _goto :FAILSYSLOCALSVC;
_if(_cp("{K_SERVICE_CALLBACK}","device_crash")) | _goto :BACKLOADCRASH;
_if(_cp("{K_SERVICE_CALLBACK}","user_hiber")) | _goto :NULLKERNEL_DEBUG;
_if(_cp("{K_SERVICE_CALLBACK}","UNAUHORIZED_TAMPING")) | _goto :UNAUHORIZED_TAMPING;
_if(_cp("{K_SERVICE_CALLBACK}","CRITICAL_INITIALIZATION_FAILURE")) | _goto :CRITICAL_INITIALIZATION_FAILURE;
_if(_cp("{K_SERVICE_CALLBACK}","BAD_SYSTEM_CONFIG")) | _goto :BAD_SYSTEM_CONFIG;
_if(_cp("{K_SERVICE_CALLBACK}","system_end_of_evaluation")) | _goto :system_end_of_evaluation;
_if(_cp("{K_SERVICE_CALLBACK}","ok")) | _goto :FAILSERVICEBACK;
_if(_cp("{K_SERVICE_CALLBACK}","FailedCrashDrvLoader")) | _goto :FailedCrashDrvLoader;
_if(_cp("{K_SERVICE_CALLBACK}","The script terminated unexpectedly.")) | _goto :CRITICAL_PROCESS_DEAD;
_if(_cp("{K_SERVICE_CALLBACK}","runid.exit")) | _goto :CRITICAL_PROCESS_DEAD;
_var {BUG_REPORT} = "croskrnl.ca";
//_var {ToolsName} = "OS Kernel";
_var {NATVC_CRASH_CODE} = "SYSTEM_SERVICE_EXCEPTION";
_var {NATVC_CRASH_MESSAGE} = "The system kernel has detected an unrecoverable error. Code: {K_SERVICE_CALLBACK}";

_goto :BACKLOADCRASH;


:FAILSYSMODE;
_file_write "[%time%][Kernel][Error][Exception] CID : failsys (unexpected)";
_var {BUG_REPORT} = "croskrnl.ca";
_var {NATVC_CRASH_CODE} = "CRITICAL_MODULE_DIED";
_var {NATVC_CRASH_MESSAGE} = "A Critical Module unexpected died . Your device needs to be aware of this problem";
_if(_cp("{FAILSYS_MBU}","true"))|_var {NATVC_CRASH_CODE} = "DEBUG_CRASH_SCREEN";
_if(_cp("{FAILSYS_MBU}","true"))|_var {NATVC_CRASH_MESSAGE} = "Display Crash Screen not happend any error. Just for debug crash scrren";
_if(_cp("{FAILSYS_MBU}","true"))|_var {ToolsName} = "No Bug happend";
_if(_cp("{FAILSYS_MBU}","true"))|_var {BUG_REPORT} = "Debug Mode";
_var {FAILSYS_MBU} = "false";
_goto :BACKLOADCRASH;

:NULLKERNEL_DEBUG;
_file_write "[%time%][Kernel][Error][Exception] CID : FailKernel_Debug (unexpected)";
_var {BUG_REPORT} = "croskrnl.ca";
_var {NATVC_CRASH_CODE} = "INVALID_SERVICE_OPERATION";
_var {NATVC_CRASH_MESSAGE} = "This service prohibits invocation of kernel operations";
_goto :BACKLOADCRASH;

:FAILSERVICEBACK;
_file_write "[%time%][Kernel][Error][Exception] CID : FailKernel_Debug (unexpected)";
_var {BUG_REPORT} = "croskrnl.ca";
_var {NATVC_CRASH_CODE} = "KERNEL_SERVICE_ERROR";
_var {NATVC_CRASH_MESSAGE} = "Kernel service error";
_goto :BACKLOADCRASH;

:FAILLOGIN_SYSTEM;
_file_write "[%time%][Kernel][Error][Exception] CID : SYSTEM Module User Initialization failed (unexpected)";
_var {BUG_REPORT} = "croskrnl.ca";
_var {NATVC_CRASH_CODE} = "NTVLOGON_FATAL_ERROR";
_var {NATVC_CRASH_MESSAGE} = "Kernel service error";
_goto :BACKLOADCRASH;

:FAILSYSLOCALSVC;
_file_write "[%time%][Kernel][Error][Exception] CID : ntvlogon.ca Module Prepare Service failed (unexpected)";
_var {BUG_REPORT} = "ntvlogon.ca";
_var {NATVC_CRASH_CODE} = "LOCAL_SERVICE_FAILED";
_var {NATVC_CRASH_MESSAGE} = "System Service error";
_goto :BACKLOADCRASH;

:UNAUHORIZED_TAMPING;
_file_write "[%time%][Kernel][Error][Exception] CID : Unauthorized product tampering has been detected in the current system";
_var {BUG_REPORT} = "ntvlogon.ca";
_var {NATVC_CRASH_CODE} = "UNAUHORIZED_TAMPERING";
_var {NATVC_CRASH_MESSAGE} = "Unauthorized product tampering Detected!";
_goto :BACKLOADCRASH;

:FailedCrashDrvMissing;
_file_write "[%time%][Kernel][Error][Exception] Driver load failed. file missing drvload.ca";
_var {BUG_REPORT} = "croskrnl.ca";
_var {NATVC_CRASH_CODE} = "DRIVER_LOAD_FAILED";
_var {NATVC_CRASH_MESSAGE} = "Driver load failed. missing file : drvload.ca";
_goto :BACKLOADCRASH;

:CRITICAL_INITIALIZATION_FAILURE;
_file_write "[%time%][Kernel][Error][Exception] The kernel encountered a fatal error while trying to initialize the system";
_var {BUG_REPORT} = "croskrnl.ca";
_var {NATVC_CRASH_CODE} = "CRITICAL_INITIALIZATION_FAILURE";
_var {NATVC_CRASH_MESSAGE} = "The kernel encountered a fatal error while trying to initialize the system";
_goto :BACKLOADCRASH;

:BAD_SYSTEM_CONFIG;
_file_write "[%time%][Kernel][Error][Exception] System configuration error prevents recovery";
_var {BUG_REPORT} = "UserModeApplication";
_var {NATVC_CRASH_CODE} = "BAD_SYSTEM_CONFIG";
_var {NATVC_CRASH_MESSAGE} = "System configuration error prevents recovery";
_goto :BACKLOADCRASH;

:FailedCrashDrvLoader;
_file_write "[%time%][Kernel][Error][Exception] Driver load failed. Unexpected error detected";
_var {BUG_REPORT} = _str_replace "{DriverFile}" ("{SYS_NROOT}/drivers/","");
_var {NATVC_CRASH_CODE} = "DRIVER_LOAD_ERROR";
_var {NATVC_CRASH_MESSAGE} = "Driver load error. message {drvload_callback}";
_goto :BACKLOADCRASH;

:system_end_of_evaluation;
_file_write "[%time%][Kernel][Error][Exception] System End of Evaluation. by ntvlogon";
_var {BUG_REPORT} = "Kernel Manager";
_var {NATVC_CRASH_CODE} = "SYSTEM_END_OF_EVALUATION";
_var {NATVC_CRASH_MESSAGE} = "This code indicates that the trial period of the Coral has ended.";
_goto :BACKLOADCRASH;

:CRITICAL_PROCESS_DEAD;
_file_write "[%time%][Kernel][Error][Exception] Critical Process unexpected dead.";
_var {BUG_REPORT} = "Session Watcher";
_var {NATVC_CRASH_CODE} = "CRITICAL_PROCESS_DEAD";
_var {NATVC_CRASH_MESSAGE} = "Critical Process unexpected dead.system cannot recovery process status";
_goto :BACKLOADCRASH;

:BACKLOADCRASH;
_file_write "[%time%][Kernel][Error] Crash Screen Load";
_file_write "[%time%][Kernel][Error] Crash Error    : {NATVC_CRASH_CODE}";
_file_write "[%time%][Kernel][Error] Error Message  : {NATVC_CRASH_MESSAGE}";
_file_write "[%time%][Kernel][Error] Last Execute Program is {ToolsName}";


//Display Crash Screen
_clear;
_if(!_file_exist "{NATVC_CRASH_TEXT}")|_goto :MissResCT;
_typefile "{NATVC_CRASH_TEXT}";
:MissResCT;
_if(!_file_exist "{NATVC_CRASH_TEXT}")|_clear;

_if(!_file_exist "{NATVC_CRASH_TEXT}")|_cout "Your device ran into problem. need restart now";
_if(!_file_exist "{NATVC_CRASH_TEXT}")|_cout "Stop Code :  {NATVC_CRASH_CODE}";
_if(!_file_exist "{NATVC_CRASH_TEXT}")|_cout "Some Resources File is missing. the crash screen could not display";
_if(!_file_exist "{NATVC_CRASH_TEXT}")|_cout "Try to reinstall Natvc";

_file_write "[%time%][Kernel][Error] Crash Report print Complete";
_file_write "[%time%][Kernel][Notice] If you are unable to resolve this issue, please contact us";

_if(!_file_exist "{SYS_ROOT}/krnlrep.ca")|_cout "[Error] Could not collect error report.   krnlrep.ca missing";
_if(!_file_exist "{SYS_ROOT}/krnlrep.ca")|_return "ok";
_script <"{SYS_ROOT}/krnlrep.ca"> "kernelmode";


_return "true";
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/Kernel/krnldmp.ca);
$CSTP_FILE_RECORD_MARK_ID_START(/Coral/System/Kernel/krnlvf.ca);
_$directmode;
