:EndloadPage;
_cout "----------------------------------------------------------------";
_prts "File (type open to select file)>";
_var {ACCESS_URL} = _getline;
_if(_cp("{ACCESS_URL}","exit"))|_return "close";
_if(_cp("{ACCESS_URL}",".exit"))|_return "close";
_if(_cp("{ACCESS_URL}","opensyslog"))|_var {ACCESS_URL} = "{SYS_LOG}";
_if(_cp("{ACCESS_URL}","openeula"))|_var {ACCESS_URL} = "{SYS_NROOT}/res/natvc-eula.txt";
