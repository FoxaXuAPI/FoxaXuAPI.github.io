:SkipInitRAMDISK;

_var {ntvl_temp} = _getargs;

_if(!_cp("{ntvl_temp}","Kernel_int_load_system"))|_return "failuserauth";

//SYSTEM New Logon Service
_file_open "{SYS_LOG}";
_file_write "[%time%][Coral Logon] The system logon service is start";

//Check Is System Need Load StartupExecute
_if(_file_exist "{SYS_NROOT}/SystemUser/TaskUserExecute/startupTask.ca")|_goto :StartExecuteNSTK;
:BackNSTK;

//Load User Logon Interface
//Try Get System Activate
_if(!_file_exist "{SYS_ROOT}/slmgr.ca")|_return "UNAUHORIZED_TAMPING";
_var {SYS_ACT_STATUS} = _script <"{SYS_ROOT}/slmgr.ca"> "verify";

_file_write "[%time%][Coral Logon] System Activate Status :  {SYS_ACT_STATUS}";

_sipcfg.open "{NATVC_CONFIG}/PRODUCT";
_if(_cp(_sipcfg RejectLoginForTimeBomb,"false"))|_goto :SkipDetectTMB;

_var {VaildTime} = _sipcfg TimeBomb;
_if(!_>=("{VaildTime}","{GET_SYSTIMEL}"))|_var {TBRejectLogin_True} = "true";

:SkipDetectTMB;

:ReinitService;
_if(!_cfgread EnforceUTF-8)|_cout "WARNING:  This Device is not enable UTF 8 Output Mode";
_if(!_cfgread EnforceUTF-8)|_cout "          There might be an error in the output";
_if(!_cfgread EnforceUTF-8)|_ms_sleep "900";

_var {ToolsName} = "Coral Logon Service";
_file_write "[%time%][Coral Logon] Attempt Load User Logon Service";
_if(!_file_exist "{SYS_NROOT}/SECURITY/SYSTEM.nuslc")|_goto :ReloginSystemUser;
_var {ntvl_process} = _script <"{SYS_ROOT}/services.ca"> "ntvue_user_logon_interface";
//Process NULI Result
_file_write "[%time%][Coral Logon] User Logon Service is stop. code:  {ntvl_process}";
_if(_file_exist "{SYS_NROOT}/SystemUser/TaskUserExecute/task.ca")|_goto :StartExecuteTSKC;


:BackTSKC;
//Break Result
_if(_cp("{ntvl_process}","relogin")) | _goto :ReinitService;
_if(_cp("{ntvl_process}","noauth")) | _goto :ReinitService;

//BadResult;
_if(_cp("{ntvl_process}","logoff")) | _goto :NUES_EXIT;
_if(_cp("{ntvl_process}","user_logoff")) | _goto :NUES_EXIT;
_if(_cp("{ntvl_process}","reload_SYSTEM")) | _goto :NUES_EXIT;
_if(_cp("{ntvl_process}","runid.exit")) | _goto :NUES_EXIT;
_if(_cp("{ntvl_process}","failuserauth")) | _goto :NUES_EXIT;
_if(_cp("{ntvl_process}","ok")) | _goto :NUES_EXIT;
_if(_cp("{ntvl_process}","false")) | _goto :NUES_EXIT;
_return "{ntvl_process}";

:NUES_EXIT;
_file_write "[%time%][Coral Logon] User Logon Service Initialization failed";
_file_write "[%time%][Coral Logon] Status Error :  {ntvl_process}";
_file_write "[%time%][Coral Logon] last program :  {ToolsName}";
_clear;
_cout " User Logon Interface - Error!";
_cout " ";
_cout "    User Logon Interface Crashed! or Cannot Startup"
_cout "    View Log to Get more informations";
_cout " ";
_cout "   Press Enter to Restart Logon Interface";
_pause;
_goto :ReinitService;



:StartExecuteTSKC;
_file_open "{SYS_NROOT}/SystemUser/TaskUserExecute/task.ca";
_file_write "_return "ok"; ";
_file_open "{SYS_LOG}";
_file_write "[%time%][Coral Logon] Run Task {SYS_NROOT}/SystemUser/TaskUserExecute/task.ca";
_clear;
_cout "Please wait... ";
_cout "The system needs to perform some operations before shutting down completely. ";
_script <"{SYS_NROOT}/SystemUser/TaskUserExecute/task.ca">;
_ms_sleep "400";
_file_del "{SYS_NROOT}/SystemUser/TaskUserExecute/task.ca";
_goto :BackTSKC;


:StartExecuteNSTK;
_file_open "{SYS_NROOT}/SystemUser/TaskUserExecute/startupTask.ca";
_file_write "_return "ok"; ";
_file_open "{SYS_LOG}";
_file_write "[%time%][Coral Logon] Run Task {SYS_NROOT}/SystemUser/TaskUserExecute/startupTask.ca";
_clear;
_cout "Please wait... ";
_cout "The system needs to perform some operations on Startup";
_var {WaitNSTKCode} = _script <"{SYS_NROOT}/SystemUser/TaskUserExecute/startupTask.ca">;
_ms_sleep "400";
_file_del "{SYS_NROOT}/SystemUser/TaskUserExecute/startupTask.ca";
_if(_cp ("{WaitNSTKCode}","$shutdown"))|_return "$shutdown";
_if(_cp ("{WaitNSTKCode}","$reboot"))|_return "$reboot";
_if(_cp ("{WaitNSTKCode}","user_shutdown"))|_return "$shutdown";
_if(_cp ("{WaitNSTKCode}","user_restart"))|_return "$reboot";
_if(_cp ("{WaitNSTKCode}","shutdown"))|_return "$shutdown";
_if(_cp ("{WaitNSTKCode}","restart"))|_return "$reboot";
_goto :BackNSTK;


:ReloginSystemUser;
_var {UserSVCBUFFER} = "KernelModeDetect";
_file_write "[%time%][Coral Logon] User:  SYSTEM. Security file Abnormal. Start relogin";

_script <"{SYS_ROOT}/usersvc.ca"> "SYSTEM";

_goto :ReinitService;
$CSTP_FILE_RECORD_MARK_ID_END(/Coral/System/ntvlogon.ca);
