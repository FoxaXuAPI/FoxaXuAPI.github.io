_var {ROOTSHELL_CALLBACK} = _loadlib <"{SYS_ROOT}/KernelAPI/CO_ShellExecute.clib"> "::ShellExecuteFiles";

_if(_cp("{ROOTSHELL_CALLBACK}","filenotfound"))|_goto :UnknownCommand;

_if(_cp("{ROOTSHELL_CALLBACK}","user_shutdown"))|_return "shutdown";
_if(_cp("{ROOTSHELL_CALLBACK}","user_restart"))|_return "restart";
_if(_cp("{ROOTSHELL_CALLBACK}","user_logoff"))|_return "logoff";
