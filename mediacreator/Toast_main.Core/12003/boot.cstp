_if(_cp("{BootMethod}","boot"))|_goto :CheckWithOld;


//MainCreateProcess
:StartCreateRELoader;
_if(_cp("{BootMethod}","nbfload"))|_file_copy("{SYS_ROOT}/BootTemple/nbf/NBF-Temple","script/vdisk/nbf/nbf/recovery");
_if(_cp("{BootMethod}","boot"))|_file_copy("{SYS_ROOT}/BootTemple/nbf/NBF-Temple","script/vdisk/sysboot/nbf/recovery");


